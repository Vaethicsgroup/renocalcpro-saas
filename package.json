{
  "name": "renocal-pro-saas",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=20.10",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:analyze": "ANALYZE=true next build",
    "export:png": "tsx scripts/export-png.ts",
    "fonts:download": "bash scripts/download-fonts.sh",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:e2e": "playwright test",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "audit:deps": "pnpm audit --audit-level=moderate",
    "audit:secrets": "gitleaks detect --no-banner --redact",
    "audit:sast": "semgrep --config=p/owasp-top-ten --error",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,json,md}\""
  },
  "dependencies": {
    "next": "^15.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@prisma/client": "^5.22.0",
    "@react-pdf/renderer": "^4.1.6",
    "next-intl": "^3.26.0",
    "next-auth": "5.0.0-beta.25",
    "@auth/prisma-adapter": "^2.7.4",
    "@anthropic-ai/sdk": "^0.32.1",
    "stripe": "^17.4.0",
    "@sentry/nextjs": "^8.45.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@upstash/ratelimit": "^2.0.5",
    "@upstash/redis": "^1.34.3",
    "@tanstack/react-query": "^5.62.0",
    "zod": "^3.24.1",
    "bcryptjs": "^2.4.3",
    "otplib": "^12.0.1",
    "isomorphic-dompurify": "^2.19.0",
    "sharp": "^0.33.5",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "tailwindcss": "^3.4.17",
    "tailwind-merge": "^2.5.5",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-popover": "^1.1.2",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.1",
    "@radix-ui/react-toast": "^1.2.2",
    "@radix-ui/react-tooltip": "^1.1.4",
    "class-variance-authority": "^0.7.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.13",
    "@types/react-dom": "^18.3.1",
    "@types/bcryptjs": "^2.4.6",
    "typescript": "^5.7.2",
    "@vitejs/plugin-react": "^4.3.4",
    "vitest": "^2.1.8",
    "@playwright/test": "^1.49.1",
    "@axe-core/playwright": "^4.10.0",
    "@next/bundle-analyzer": "^15.0.4",
    "@vitest/coverage-v8": "^2.1.8",
    "@testing-library/react": "^16.1.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@types/eslint": "^9.6.1",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.0.4",
    "eslint-plugin-security": "^3.0.1",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49"
  }
}
