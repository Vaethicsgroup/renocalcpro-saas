{
  "ci": {
    "collect": {
      "url": [
        "http://localhost:3000/fr",
        "http://localhost:3000/fr/tarifs",
        "http://localhost:3000/fr/fonctionnalites",
        "http://localhost:3000/fr/faq",
        "http://localhost:3000/fr/contact",
        "http://localhost:3000/fr/a-propos",
        "http://localhost:3000/fr/auth/signup",
        "http://localhost:3000/fr/auth/signin",
        "http://localhost:3000/fr/onboarding/individual",
        "http://localhost:3000/fr/dev/design-system"
      ],
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop",
        "throttling": { "cpuSlowdownMultiplier": 1 }
      }
    },
    "assert": {
      "assertions": {
        "categories:performance":     ["error",  { "minScore": 0.90 }],
        "categories:accessibility":   ["error",  { "minScore": 0.95 }],
        "categories:best-practices":  ["error",  { "minScore": 0.95 }],
        "categories:seo":             ["error",  { "minScore": 0.90 }],

        "first-contentful-paint":     ["warn",   { "maxNumericValue": 1800 }],
        "largest-contentful-paint":   ["error",  { "maxNumericValue": 2500 }],
        "cumulative-layout-shift":    ["error",  { "maxNumericValue": 0.10 }],
        "total-blocking-time":        ["warn",   { "maxNumericValue": 300 }],

        "color-contrast":             "error",
        "image-alt":                  "error",
        "html-has-lang":              "error",
        "html-lang-valid":            "error",
        "meta-viewport":              "error",
        "tap-targets":                "error",

        "is-on-https":                "off",
        "uses-http2":                 "off"
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./.lighthouseci"
    }
  }
}
