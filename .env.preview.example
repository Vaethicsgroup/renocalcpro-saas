# ═══════════════════════════════════════════════════════════════════════
# RENOCALCPRO — Variables Vercel Preview (mode démo public partageable)
# ═══════════════════════════════════════════════════════════════════════
# Ces variables sont pensées pour une preview Vercel sans risque :
# - AUCUN secret Stripe live
# - AUCUNE clé Anthropic prod
# - Base de données isolée (Neon free tier, Supabase free, ou Postgres embarqué)
# - Emails désactivés (magic link non nécessaire pour la démo)
# - Feature flags démo activés
#
# À copier / adapter dans Vercel → Project Settings → Environment Variables
# (Environment: "Preview" uniquement, PAS "Production")
# ═══════════════════════════════════════════════════════════════════════

# ── 1. Mode démo & sécurité ─────────────────────────────────────────────
NODE_ENV=production
NEXT_PUBLIC_APP_NAME="Réno·Calc Pro (Beta)"
NEXT_PUBLIC_DEFAULT_LOCALE=fr
APP_LOG_LEVEL=info

# URL de la preview — remplacer par ton URL Vercel réelle après premier deploy
# Ex: https://renocalcpro-saas-git-wip-preprod-hardening-vaethicsgroup.vercel.app
NEXT_PUBLIC_APP_URL=https://YOUR-VERCEL-PREVIEW.vercel.app
AUTH_URL=https://YOUR-VERCEL-PREVIEW.vercel.app
AUTH_TRUST_HOST=true

# Flag démo — désactive les webhooks live, active les comptes seed, mocke Stripe
DEMO_MODE=true
FEATURE_AGENTS_ENABLED=false          # AI Claude off en preview (économie de coûts)
NEXT_PUBLIC_ENABLE_DEMO_ADMIN=true

# ── 2. Base de données ─────────────────────────────────────────────────
# Recommandé : Neon.tech (gratuit, Postgres serverless, région eu-west)
# 1. https://neon.tech → New Project (region: EU West Frankfurt)
# 2. Copie le "Pooled connection string"
# 3. Colle ici
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.eu-central-1.aws.neon.tech/renocalcpro_demo?sslmode=require

# ── 3. Auth (NextAuth v5) ──────────────────────────────────────────────
# Générer une fois : openssl rand -base64 64
AUTH_SECRET=REGENERATE_ONCE_AND_PASTE
NEXTAUTH_URL=https://YOUR-VERCEL-PREVIEW.vercel.app

# ── 4. Audit log HMAC ──────────────────────────────────────────────────
# Générer une fois : openssl rand -hex 32
AUDIT_HMAC_KEY=REGENERATE_ONCE_AND_PASTE_32_HEX_CHARS

# ── 5. Stripe MODE MOCK ────────────────────────────────────────────────
# En preview on ne touche PAS Stripe live. Le mode mock fait des paiements
# fictifs pour tester le parcours d'abonnement sans facturer.
STRIPE_MOCK=true
# Ces 2 valeurs restent VIDES en preview (le mock les ignore).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── 6. Anthropic / AI Assistant — DÉSACTIVÉ en preview ────────────────
# L'assistant IA est off en preview pour éviter les coûts.
ANTHROPIC_API_KEY=
ASSISTANT_DEGRADED_MODE=true

# ── 7. Storage — mode local (pas de S3 requis en preview) ─────────────
STORAGE_DRIVER=local-fs
LOCAL_STORAGE_PATH=/tmp/renocalcpro-uploads
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── 8. Redis — désactivé (rate-limit fallback en mémoire) ──────────────
REDIS_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── 9. Emails — désactivé (login sans magic link en preview) ──────────
# Le mode démo permet une connexion directe via les comptes seed.
EMAIL_MOCK=true
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
AUTH_EMAIL_FROM=demo@renocalcpro.fr
EMAIL_FROM=demo@renocalcpro.fr

# ── 10. Sentry — désactivé en preview ──────────────────────────────────
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=

# ── 11. Autres ─────────────────────────────────────────────────────────
NEXT_TELEMETRY_DISABLED=1
SKIP_ENV_VALIDATION=1
# Bypass auth pour faciliter les tests (accepte n'importe quel email de sign-in)
NEXT_PUBLIC_BYPASS_AUTH=false   # laisser false, on préfère les comptes seed
