/** Helper : récupère une fiche reconnaissance */
export function getRecognizeGuide(ref: string): RecognizeGuide | null {
  return RECOGNIZE_GUIDES[ref] ?? null;
}

/** Helper : liste les guides d'une catégorie */
export function listRecognizeGuides(category: RecognizeGuide["category"]): RecognizeGuide[] {
  return Object.values(RECOGNIZE_GUIDES).filter(g => g.category === category);
}
