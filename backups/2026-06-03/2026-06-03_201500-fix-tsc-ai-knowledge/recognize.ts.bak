// lib/ai/assistant/knowledge/recognize.ts
// Aide à la RECONNAISSANCE in-situ de matériaux, isolants, systèmes.
// L'IA propose des indices observables, des tests simples, des photos types.
// Pas de remplacement d'un sondage destructif si doute persistant.

export interface RecognizeGuide {
  /** Référence : "wall:pierre", "insulation:laine_verre", "heating:pac_air_eau" */
  ref: string;
  /** Catégorie pour le routing */
  category: "material" | "insulation" | "system" | "structure" | "glazing";
  /** Ce qu'on cherche à reconnaître */
  label: string;
  /** Indices visuels observables sans démontage */
  visualClues: string[];
  /** Tests simples non destructifs (toucher, son, mesure) */
  simpleTests: string[];
  /** Tests semi-destructifs si doute persistant (gratter enduit, démonter prise) */
  invasiveTests?: string[];
  /** Différencier des matériaux/systèmes voisins (pièges) */
  distinguishFrom: Array<{ otherRef: string; otherLabel: string; tellingDifference: string }>;
  /** Quand préférer « inconnu » plutôt qu'une mauvaise hypothèse */
  whenLeaveUnknown: string;
}

