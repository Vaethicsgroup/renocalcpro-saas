// app/[locale]/(public)/contact/page.tsx — Page Contact v3.0 « Energy Trust »
// Pictogrammes Lucide, cards blanches bordure fine, fond cream-50, titres bleu
// nuit, CTA primary vert énergie.

import { setRequestLocale } from "next-intl/server";
import {
  Mail,
  Phone,
  MapPin,
  ShieldCheck,
  Newspaper,
  type LucideIcon,
} from "lucide-react";

interface Props {
  params: Promise<{ locale: string }>;
}

export default async function ContactPage({ params }: Props) {
  const { locale } = await params;
  setRequestLocale(locale);

  return (
    <main className="relative bg-cream-50 pb-24">
      {/* Halo discret vert énergie en haut */}
      <div
        aria-hidden
        className="pointer-events-none absolute inset-x-0 top-0 h-[500px] overflow-hidden"
      >
        <div className="absolute -top-32 left-1/2 h-72 w-[600px] -translate-x-1/2 rounded-full bg-forest-100/40 blur-3xl sm:h-96 sm:w-[800px]" />
      </div>

      <header className="relative mx-auto max-w-4xl px-6 pt-16 text-center md:pt-20">
        <p className="inline-flex items-center gap-2 rounded-full border border-cream-300 bg-white/85 px-3 py-1.5 text-xs font-semibold uppercase tracking-wider text-forest-700 shadow-soft">
          <span aria-hidden className="h-1.5 w-1.5 rounded-full bg-forest-500" />
          Contact &amp; démo
        </p>
        <h1
          className="mt-4 font-serif text-4xl font-bold leading-tight tracking-tight text-night-800 md:text-5xl lg:text-6xl"
          style={{ fontFamily: "Source Serif 4, Georgia, serif" }}
        >
          Parlons de votre projet
        </h1>
        <p className="mt-5 text-lg leading-relaxed text-stone-600">
          Notre équipe vous répond sous 24 h ouvrées. Démo personnalisée sur
          demande.
        </p>
      </header>

      <div className="relative mx-auto mt-12 grid max-w-6xl gap-8 px-6 lg:grid-cols-[1.4fr_1fr]">
        {/* Formulaire */}
        <section className="rounded-2xl border border-cream-300 bg-white p-8 shadow-card">
          <h2
            className="font-serif text-2xl font-bold text-night-800"
            style={{ fontFamily: "Source Serif 4, Georgia, serif" }}
          >
            Envoyez-nous un message
          </h2>
          <form className="mt-6 grid gap-5 sm:grid-cols-2">
            <Field label="Prénom" htmlFor="firstname" required>
              <input
                id="firstname"
                name="firstname"
                type="text"
                autoComplete="given-name"
                required
                className="h-10 w-full rounded-lg border border-cream-300 bg-white px-3.5 text-sm text-night-800 placeholder-stone-400 transition-colors focus:border-forest-500 focus:outline-none focus:ring-2 focus:ring-forest-200/40"
              />
            </Field>
            <Field label="Nom" htmlFor="lastname" required>
              <input
                id="lastname"
                name="lastname"
                type="text"
                autoComplete="family-name"
                required
                className="h-10 w-full rounded-lg border border-cream-300 bg-white px-3.5 text-sm text-night-800 placeholder-stone-400 transition-colors focus:border-forest-500 focus:outline-none focus:ring-2 focus:ring-forest-200/40"
              />
            </Field>
            <Field label="Email" htmlFor="email" required className="sm:col-span-2">
              <input
                id="email"
                name="email"
                type="email"
                autoComplete="email"
                required
                className="h-10 w-full rounded-lg border border-cream-300 bg-white px-3.5 text-sm text-night-800 placeholder-stone-400 transition-colors focus:border-forest-500 focus:outline-none focus:ring-2 focus:ring-forest-200/40"
              />
            </Field>
            <Field
              label="Société (optionnel)"
              htmlFor="company"
              className="sm:col-span-2"
            >
              <input
                id="company"
                name="company"
                type="text"
                autoComplete="organization"
                className="h-10 w-full rounded-lg border border-cream-300 bg-white px-3.5 text-sm text-night-800 placeholder-stone-400 transition-colors focus:border-forest-500 focus:outline-none focus:ring-2 focus:ring-forest-200/40"
              />
            </Field>
            <Field
              label="Type de demande"
              htmlFor="topic"
              required
              className="sm:col-span-2"
            >
              <select
                id="topic"
                name="topic"
                required
                className="h-10 w-full rounded-lg border border-cream-300 bg-white px-3.5 text-sm text-night-800 transition-colors focus:border-forest-500 focus:outline-none focus:ring-2 focus:ring-forest-200/40"
              >
                <option value="">— Sélectionner —</option>
                <option value="demo">Demande de démo personnalisée</option>
                <option value="pricing">Tarifs Entreprise / sur devis</option>
                <option value="partnership">Partenariat</option>
                <option value="press">Presse / journalistes</option>
                <option value="support">Support technique (compte existant)</option>
                <option value="other">Autre</option>
              </select>
            </Field>
            <Field
              label="Votre message"
              htmlFor="message"
              required
              className="sm:col-span-2"
            >
              <textarea
                id="message"
                name="message"
                rows={5}
                required
                placeholder="Décrivez votre projet, votre équipe, vos enjeux…"
                className="w-full rounded-lg border border-cream-300 bg-white px-3.5 py-2 text-sm text-night-800 placeholder-stone-400 transition-colors focus:border-forest-500 focus:outline-none focus:ring-2 focus:ring-forest-200/40"
              />
            </Field>
            <div className="sm:col-span-2">
              <label className="flex items-start gap-2 text-xs text-stone-600">
                <input
                  type="checkbox"
                  required
                  className="mt-0.5 h-4 w-4 rounded border-cream-300 text-forest-600 accent-forest-600"
                />
                <span>
                  J&apos;accepte que mes données soient traitées conformément à
                  la{" "}
                  <a
                    href={`/${locale}/legal/privacy`}
                    className="font-semibold text-forest-700 transition-colors hover:text-forest-800 hover:underline"
                  >
                    politique de confidentialité
                  </a>
                  .
                </span>
              </label>
            </div>
            <button
              type="submit"
              className="sm:col-span-2 inline-flex h-12 items-center justify-center rounded-lg bg-forest-600 px-6 text-base font-semibold text-white shadow-soft transition-colors hover:bg-forest-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-forest-400 focus-visible:ring-offset-2"
            >
              Envoyer ma demande
            </button>
          </form>
        </section>

        {/* Sidebar contacts */}
        <aside className="space-y-3">
          <ContactCard
            Icon={Mail}
            title="Email"
            primary="contact@renocalcpro.fr"
            href="mailto:contact@renocalcpro.fr"
          />
          <ContactCard
            Icon={Phone}
            title="Téléphone"
            primary="+33 4 XX XX XX XX"
            secondary="Lun-Ven 9 h-18 h"
          />
          <ContactCard
            Icon={MapPin}
            title="Adresse"
            primary="RENOCALCPRO"
            secondary="38000 Grenoble · France"
          />
          <ContactCard
            Icon={ShieldCheck}
            title="DPO RGPD"
            primary="dpo@renocalcpro.fr"
            href="mailto:dpo@renocalcpro.fr"
          />
          <ContactCard
            Icon={Newspaper}
            title="Presse"
            primary="presse@renocalcpro.fr"
            href="mailto:presse@renocalcpro.fr"
          />
        </aside>
      </div>
    </main>
  );
}

function Field({
  label,
  htmlFor,
  required,
  className = "",
  children,
}: {
  label: string;
  htmlFor: string;
  required?: boolean;
  className?: string;
  children: React.ReactNode;
}) {
  return (
    <div className={`flex flex-col gap-1.5 ${className}`}>
      <label htmlFor={htmlFor} className="text-sm font-medium text-night-800">
        {label}
        {required && (
          <span aria-hidden className="ml-0.5 text-error-600">
            *
          </span>
        )}
      </label>
      {children}
    </div>
  );
}

function ContactCard({
  Icon,
  title,
  primary,
  secondary,
  href,
}: {
  Icon: LucideIcon;
  title: string;
  primary: string;
  secondary?: string;
  href?: string;
}) {
  const inner = (
    <>
      <span
        aria-hidden
        className="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-forest-100 text-forest-700"
      >
        <Icon className="h-5 w-5" strokeWidth={1.75} />
      </span>
      <div>
        <p className="text-2xs font-semibold uppercase tracking-wider text-stone-500">
          {title}
        </p>
        <p className="mt-0.5 text-sm font-semibold text-night-800">{primary}</p>
        {secondary && (
          <p className="mt-0.5 text-xs text-stone-600">{secondary}</p>
        )}
      </div>
    </>
  );

  const base =
    "flex items-start gap-3 rounded-xl border border-cream-300 bg-white p-4 shadow-card transition-colors";

  return href ? (
    <a href={href} className={`${base} hover:border-forest-300`}>
      {inner}
    </a>
  ) : (
    <div className={base}>{inner}</div>
  );
}

export const metadata = {
  title: "Contact — RENOCALCPRO",
  description:
    "Contactez l'équipe RENOCALCPRO pour une démo, un devis ou toute question.",
};
