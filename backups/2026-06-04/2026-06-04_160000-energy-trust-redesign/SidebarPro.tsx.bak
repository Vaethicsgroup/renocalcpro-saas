// components/layout/SidebarPro.tsx — Sidebar espace pro v3.0 (Sprint v2.4)
// Fond forest-800 dense + logo officiel en theme="light" (blanc sur fond foncé).
// Active state : fond forest-700 + bord gauche forest-400.

"use client";

import Link from "next/link";
import { usePathname } from "next/navigation";
import { useState } from "react";
import { Logo } from "@/components/ui/Logo";

interface Props { locale: string }

interface NavSection { title: string; items: Array<{ href: string; icon: string; label: string }> }

const NAV: NavSection[] = [
  {
    title: "Production",
    items: [
      { href: "/o/dashboard", icon: "📊", label: "Tableau de bord" },
      { href: "/o/projects",  icon: "📁", label: "Dossiers" },
      { href: "/o/reports",   icon: "📄", label: "Rapports" },
    ],
  },
  {
    title: "Relation client",
    items: [
      { href: "/o/clients",   icon: "👥", label: "Clients" },
      { href: "/o/portal",    icon: "🔗", label: "Portail client" },
    ],
  },
  {
    title: "Bibliothèque",
    items: [
      { href: "/o/library/materials", icon: "🧱", label: "Matériaux" },
      { href: "/o/library/systems",   icon: "⚙️", label: "Systèmes" },
    ],
  },
  {
    title: "Organisation",
    items: [
      { href: "/o/team",      icon: "🧑‍🤝‍🧑", label: "Équipe" },
      { href: "/o/branding",  icon: "🎨", label: "Marque" },
    ],
  },
  {
    title: "Compte",
    items: [
      { href: "/o/billing",   icon: "💳", label: "Facturation" },
      { href: "/o/settings",  icon: "⚙️", label: "Paramètres" },
    ],
  },
];

export function SidebarPro({ locale }: Props) {
  const pathname = usePathname();
  const [open, setOpen] = useState(false);

  function isActive(href: string) {
    return pathname?.includes(href);
  }

  return (
    <>
      {/* Hamburger mobile */}
      <button
        type="button"
        onClick={() => setOpen(true)}
        aria-label="Ouvrir le menu"
        className="fixed left-3 top-3 z-30 inline-flex h-10 w-10 items-center justify-center rounded-lg border border-cream-300 bg-white shadow-card md:hidden"
      >
        <svg viewBox="0 0 24 24" className="h-5 w-5 text-forest-800" fill="none" stroke="currentColor" strokeWidth="2">
          <path strokeLinecap="round" strokeLinejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>

      {open && (
        <div className="fixed inset-0 z-30 bg-forest-950/60 md:hidden" onClick={() => setOpen(false)} aria-hidden />
      )}

      <aside
        aria-label="Navigation espace pro"
        className={[
          "fixed inset-y-0 left-0 z-40 flex w-72 flex-col border-r border-forest-950 bg-forest-800 p-5 text-cream-100 transition-transform md:static md:translate-x-0",
          open ? "translate-x-0" : "-translate-x-full md:translate-x-0",
        ].join(" ")}
      >
        {/* Header LOGO officiel (variante blanche pour fond foncé) */}
        <div className="mb-6 flex items-center justify-between">
          <Logo href={`/${locale}/o/dashboard`} variant="wordmark" theme="light" withTagline />
          <button type="button" onClick={() => setOpen(false)} aria-label="Fermer" className="rounded-lg p-1 text-cream-200/60 hover:bg-forest-700 md:hidden">✕</button>
        </div>

        {/* Navigation groupée */}
        <nav className="flex-1 overflow-y-auto space-y-5 pr-1" aria-label="Sections">
          {NAV.map(s => (
            <div key={s.title}>
              <h3 className="mb-1.5 px-3 text-2xs font-semibold uppercase tracking-wider text-forest-300/70">
                {s.title}
              </h3>
              <ul className="space-y-0.5">
                {s.items.map(n => {
                  const active = isActive(n.href);
                  return (
                    <li key={n.href}>
                      <Link
                        href={`/${locale}${n.href}`}
                        onClick={() => setOpen(false)}
                        aria-current={active ? "page" : undefined}
                        className={[
                          "relative flex items-center gap-3 rounded-lg px-3 py-2 text-sm font-medium transition-colors",
                          active
                            ? "bg-forest-700 text-cream-50 shadow-inner"
                            : "text-cream-200/85 hover:bg-forest-700/60 hover:text-cream-50",
                        ].join(" ")}
                      >
                        {active && <span aria-hidden className="absolute left-0 top-1.5 bottom-1.5 w-0.5 rounded-full bg-forest-300" />}
                        <span aria-hidden className="text-base">{n.icon}</span>
                        <span>{n.label}</span>
                      </Link>
                    </li>
                  );
                })}
              </ul>
            </div>
          ))}
        </nav>

        {/* User badge bas */}
        <div className="mt-4 rounded-xl border border-forest-700 bg-forest-900/50 p-3">
          <div className="flex items-center gap-2.5">
            <span aria-hidden className="flex h-9 w-9 items-center justify-center rounded-full bg-cream-100 text-xs font-bold text-forest-800">JD</span>
            <div className="min-w-0 flex-1">
              <p className="truncate text-xs font-semibold text-cream-50">Jean Dupont</p>
              <p className="truncate text-2xs text-forest-300">Cabinet Dupont · Auditeur</p>
            </div>
          </div>
        </div>
      </aside>
    </>
  );
}
