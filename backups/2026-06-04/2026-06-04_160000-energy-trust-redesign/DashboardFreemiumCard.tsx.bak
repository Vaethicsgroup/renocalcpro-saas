// src/components/billing/DashboardFreemiumCard.tsx — étape E
// Server Component intégrable dans /p/dashboard et /p/projects.
// Affiche :
//   - badge plan (PlanBadge)
//   - phrase compteur projets (1 restant / illimité)
//   - CTA upgrade en lien serveur (pas de onClick / pas de client-side state)
//
// Pas de "use client". Aucune logique policy : reflète l'état décidé serveur.
// Si tu veux montrer un message "bloqué", passe `blockedReason` — la card
// affichera la copie associée via getUpgradeReason (pure).

import type { JSX, ReactNode } from "react";
import Link from "next/link";
import { PlanBadge } from "./PlanBadge";
import { type BillingPlan } from "@/lib/billing/plan-limits";
import {
  getUpgradeReason,
  type UpgradeReason,
} from "@/lib/billing/usage-policy";

export interface DashboardFreemiumCardProps {
  plan: BillingPlan;
  remainingProjects: number | "unlimited";
  /** Locale courante pour construire l'URL d'upgrade. */
  locale: string;
  /** Si défini, affiche la copie d'upgrade associée à la raison. */
  blockedReason?: UpgradeReason;
  /** Slot footer optionnel (ex: lien support). */
  footer?: ReactNode;
}

export function DashboardFreemiumCard({
  plan,
  remainingProjects,
  locale,
  blockedReason,
  footer,
}: DashboardFreemiumCardProps): JSX.Element {
  const isFree = plan === "FREE";
  const upgradeHref = `/${locale}/tarifs`;
  const cta = blockedReason ? getUpgradeReason(blockedReason) : null;

  const counterText =
    remainingProjects === "unlimited"
      ? "Projets illimités"
      : isFree
        ? `${remainingProjects} projet${remainingProjects > 1 ? "s" : ""} gratuit${
            remainingProjects > 1 ? "s" : ""
          } restant${remainingProjects > 1 ? "s" : ""}`
        : `${remainingProjects} projet${remainingProjects > 1 ? "s" : ""} restant${
            remainingProjects > 1 ? "s" : ""
          }`;

  return (
    <section
      aria-label="Statut de votre offre"
      data-testid="dashboard-freemium-card"
      data-plan={plan}
      className="rounded-lg border border-stone-200 bg-white p-4 shadow-sm"
    >
      <div className="flex flex-wrap items-center justify-between gap-3">
        <div className="flex items-center gap-3">
          <PlanBadge plan={plan} />
          <span className="text-sm text-stone-700">{counterText}</span>
        </div>

        {isFree ? (
          <Link
            href={upgradeHref}
            data-testid="dashboard-freemium-cta"
            className="inline-flex h-9 items-center justify-center rounded-md bg-teal-700 px-3 text-sm font-semibold text-white hover:bg-teal-800"
          >
            Passer à Pro
          </Link>
        ) : null}
      </div>

      {cta ? (
        <div
          className="mt-3 rounded-md border border-amber-200 bg-amber-50 p-3"
          role="status"
          data-testid="dashboard-freemium-block"
          data-reason={blockedReason}
        >
          <div className="text-sm font-medium text-amber-900">{cta.title}</div>
          <div className="mt-1 text-sm text-amber-900/90">{cta.body}</div>
          <Link
            href={upgradeHref}
            className="mt-2 inline-flex items-center rounded-md bg-amber-700 px-3 py-1 text-xs font-medium text-white hover:bg-amber-800"
          >
            {cta.ctaLabel}
          </Link>
        </div>
      ) : null}

      {footer ? (
        <div className="mt-3 text-xs text-stone-500">{footer}</div>
      ) : null}
    </section>
  );
}
