// components/layout/SidebarAdmin.tsx — Sidebar admin v3.0 (Sprint v2.4)
// Fond forest-900 dense (cohérent avec sidebar pro) + accent amber pour différencier.
// Banner audit + logo officiel.

"use client";

import Link from "next/link";
import { usePathname } from "next/navigation";
import { useState } from "react";
import { Logo } from "@/components/ui/Logo";

interface Props { locale: string }

interface NavSection { title: string; items: Array<{ href: string; icon: string; label: string }> }

const NAV: NavSection[] = [
  {
    title: "Pilotage",
    items: [
      { href: "/admin",                icon: "📊", label: "Tableau de bord" },
      { href: "/admin/analytics",      icon: "📈", label: "Analytics" },
      { href: "/admin/health",         icon: "💚", label: "Health système" },
    ],
  },
  {
    title: "Comptes",
    items: [
      { href: "/admin/users",          icon: "👤", label: "Utilisateurs" },
      { href: "/admin/professionals",  icon: "🧑‍💼", label: "Professionnels" },
      { href: "/admin/organizations",  icon: "🏢", label: "Organisations" },
      { href: "/admin/impersonations", icon: "🔑", label: "Impersonations" },
    ],
  },
  {
    title: "Données métier",
    items: [
      { href: "/admin/projects",       icon: "📁", label: "Projets" },
      { href: "/admin/aids",           icon: "💶", label: "Aides & dispositifs" },
      { href: "/admin/library",        icon: "📚", label: "Bibliothèque" },
      { href: "/admin/content",        icon: "📝", label: "Contenus" },
    ],
  },
  {
    title: "Système",
    items: [
      { href: "/admin/webhook-deliveries", icon: "🔔", label: "Webhooks" },
      { href: "/admin/abtests",            icon: "🧪", label: "A/B Tests" },
      { href: "/admin/funnels",            icon: "📐", label: "Funnels" },
      { href: "/admin/ai-assistant",       icon: "🤖", label: "Assistant IA" },
      { href: "/admin/settings",           icon: "⚙️", label: "Paramètres" },
    ],
  },
];

export function SidebarAdmin({ locale }: Props) {
  const pathname = usePathname();
  const [open, setOpen] = useState(false);

  function isActive(href: string) {
    return pathname === `/${locale}${href}` || pathname?.startsWith(`/${locale}${href}/`);
  }

  return (
    <>
      <button
        type="button"
        onClick={() => setOpen(true)}
        aria-label="Ouvrir le menu"
        className="fixed left-3 top-3 z-30 inline-flex h-10 w-10 items-center justify-center rounded-lg border border-cream-300 bg-white shadow-card md:hidden"
      >
        <svg viewBox="0 0 24 24" className="h-5 w-5 text-forest-800" fill="none" stroke="currentColor" strokeWidth="2">
          <path strokeLinecap="round" strokeLinejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>

      {open && (
        <div className="fixed inset-0 z-30 bg-forest-950/60 md:hidden" onClick={() => setOpen(false)} aria-hidden />
      )}

      <aside
        aria-label="Navigation admin"
        className={[
          "fixed inset-y-0 left-0 z-40 flex w-72 flex-col border-r border-forest-950 bg-forest-900 p-5 text-cream-100 transition-transform md:static md:translate-x-0",
          open ? "translate-x-0" : "-translate-x-full md:translate-x-0",
        ].join(" ")}
      >
        {/* Header LOGO officiel (variante blanche) */}
        <div className="mb-4 flex items-center justify-between">
          <Logo href={`/${locale}/admin`} variant="wordmark" theme="light" />
          <button type="button" onClick={() => setOpen(false)} aria-label="Fermer" className="rounded-lg p-1 text-cream-200/60 hover:bg-forest-800 md:hidden">✕</button>
        </div>

        {/* Badge espace admin */}
        <div className="mb-4 inline-flex w-fit items-center gap-1.5 rounded-full bg-amber-500/20 px-3 py-1 text-2xs font-semibold uppercase tracking-wider text-amber-300">
          <span className="inline-block h-1.5 w-1.5 rounded-full bg-amber-400" />
          Espace Admin
        </div>

        {/* Banner audit */}
        <div className="mb-5 rounded-xl border border-amber-500/30 bg-amber-500/10 p-2.5 text-2xs text-amber-200">
          🛡️ Accès admin · toutes les actions sont auditées
        </div>

        {/* Navigation groupée */}
        <nav className="flex-1 overflow-y-auto space-y-5 pr-1" aria-label="Sections">
          {NAV.map(s => (
            <div key={s.title}>
              <h3 className="mb-1.5 px-3 text-2xs font-semibold uppercase tracking-wider text-cream-200/50">
                {s.title}
              </h3>
              <ul className="space-y-0.5">
                {s.items.map(n => {
                  const active = isActive(n.href);
                  return (
                    <li key={n.href}>
                      <Link
                        href={`/${locale}${n.href}`}
                        onClick={() => setOpen(false)}
                        aria-current={active ? "page" : undefined}
                        className={[
                          "relative flex items-center gap-3 rounded-lg px-3 py-2 text-sm font-medium transition-colors",
                          active
                            ? "bg-forest-800 text-amber-300"
                            : "text-cream-100/80 hover:bg-forest-800/70 hover:text-amber-300",
                        ].join(" ")}
                      >
                        {active && <span aria-hidden className="absolute left-0 top-1.5 bottom-1.5 w-0.5 rounded-full bg-amber-400" />}
                        <span aria-hidden className="text-base">{n.icon}</span>
                        <span>{n.label}</span>
                      </Link>
                    </li>
                  );
                })}
              </ul>
            </div>
          ))}
        </nav>
      </aside>
    </>
  );
}
