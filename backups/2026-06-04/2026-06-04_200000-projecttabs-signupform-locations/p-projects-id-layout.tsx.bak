// app/[locale]/p/projects/[id]/layout.tsx — Layout détail projet particulier
import type { ReactNode } from "react";
import Link from "next/link";
import { ProjectTabs } from "@/components/p/ProjectTabs";

interface Props {
  children: ReactNode;
  params: Promise<{ locale: string; id: string }>;
}

export default async function ProjectDetailLayout({ children, params }: Props) {
  const { locale, id } = await params;
  // MVP : project mocké
  const project = { name: "Maison des Tilleuls", location: "87000 Limoges" };

  return (
    <div>
      {/* Breadcrumb */}
      <nav aria-label="Fil d'Ariane" className="mb-3 text-xs text-stone-500">
        <Link href={`/${locale}/p/dashboard`} className="hover:text-teal-700">Tableau de bord</Link>
        {" › "}
        <Link href={`/${locale}/p/projects`} className="hover:text-teal-700">Mes projets</Link>
        {" › "}
        <span className="text-stone-700">{project.name}</span>
      </nav>

      {/* Header projet */}
      <header className="mb-6">
        <h1
          className="font-serif text-3xl font-bold tracking-tight text-stone-900 md:text-4xl"
          style={{ fontFamily: "Source Serif 4, Georgia, serif" }}
        >
          {project.name}
        </h1>
        <p className="mt-1 text-sm text-stone-600">📍 {project.location}</p>
      </header>

      {/* Onglets */}
      <ProjectTabs locale={locale} projectId={id} />

      <main className="mt-6">{children}</main>
    </div>
  );
}
