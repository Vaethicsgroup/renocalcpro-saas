// app/[locale]/o/projects/[id]/layout.tsx — Workspace projet pro avec sidebar projet
import type { ReactNode } from "react";
import Link from "next/link";
import { ProjectWorkspaceTabs } from "@/components/o/ProjectWorkspaceTabs";
import { Card } from "@/components/ui/Card";
import { Button } from "@/components/ui/Button";
import { StatusBadge, RoleBadge } from "@/components/ui/Badge";
import { DPELabel } from "@/components/results/DPELabel";

interface Props { children: ReactNode; params: Promise<{ locale: string; id: string }> }

export default async function WorkspaceLayout({ children, params }: Props) {
  const { locale, id } = await params;
  // MVP : projet mocké
  const project = {
    name: "Maison Martin",
    location: "33000 Bordeaux",
    surface: 132,
    year: 1972,
    currentDPE: "D" as const,
    targetDPE: "B" as const,
    client: { name: "Pierre Martin", email: "p.martin@example.fr", phone: "06 12 34 56 78" },
    status: "in_progress" as const,
    team: [
      { initials: "JD", name: "Jean Dupont", role: "owner" as const },
      { initials: "ML", name: "Marie L.",    role: "member" as const },
    ],
  };

  return (
    <div>
      {/* Breadcrumb */}
      <nav aria-label="Fil d'Ariane" className="mb-3 text-xs text-stone-500">
        <Link href={`/${locale}/o/dashboard`} className="hover:text-teal-700">Tableau de bord</Link>
        {" › "}
        <Link href={`/${locale}/o/projects`} className="hover:text-teal-700">Dossiers</Link>
        {" › "}
        <span className="text-stone-700">{project.name}</span>
      </nav>

      {/* Header workspace */}
      <header className="mb-5 flex flex-wrap items-start justify-between gap-4">
        <div>
          <div className="flex items-center gap-3">
            <h1 className="font-serif text-3xl font-bold tracking-tight text-stone-900 md:text-4xl" style={{ fontFamily: "Source Serif 4, Georgia, serif" }}>
              {project.name}
            </h1>
            <StatusBadge status="info">En cours</StatusBadge>
          </div>
          <p className="mt-1 text-sm text-stone-600">📍 {project.location} · {project.surface} m² · construit en {project.year}</p>
        </div>
        <div className="flex flex-wrap gap-2">
          <Button variant="secondary" size="md">📥 Exporter</Button>
          <Button variant="primary" size="md">📄 Générer rapport</Button>
        </div>
      </header>

      {/* Tabs */}
      <ProjectWorkspaceTabs locale={locale} projectId={id} />

      <div className="mt-6 grid gap-6 lg:grid-cols-[1fr_280px]">
        {/* Contenu de l'onglet */}
        <main>{children}</main>

        {/* Sidebar projet droite */}
        <aside className="space-y-4">
          <Card padded={false} className="overflow-hidden">
            <div className="bg-gradient-to-br from-amber-50 to-stone-50 p-5">
              <p className="text-2xs font-semibold uppercase tracking-wider text-stone-500">Étiquette DPE</p>
              <div className="mt-3 flex items-center justify-center gap-2">
                <DPELabel classification={project.currentDPE} size="md" />
                <span aria-hidden className="text-stone-400">→</span>
                <DPELabel classification={project.targetDPE} size="md" />
              </div>
              <p className="mt-3 text-center text-2xs text-stone-500">Saut de 2 classes après travaux</p>
            </div>
          </Card>

          <Card>
            <p className="text-2xs font-semibold uppercase tracking-wider text-stone-500">Client</p>
            <p className="mt-2 font-semibold text-stone-900">{project.client.name}</p>
            <p className="mt-0.5 text-xs text-stone-600">{project.client.email}</p>
            <p className="text-xs text-stone-600">{project.client.phone}</p>
            <Link href={`/${locale}/o/clients`} className="mt-3 inline-block text-xs font-semibold text-teal-700 hover:underline">
              Voir fiche client →
            </Link>
          </Card>

          <Card>
            <p className="text-2xs font-semibold uppercase tracking-wider text-stone-500">Équipe assignée</p>
            <ul className="mt-3 space-y-2">
              {project.team.map(m => (
                <li key={m.initials} className="flex items-center gap-2">
                  <span aria-hidden className="flex h-7 w-7 items-center justify-center rounded-full bg-teal-700 text-2xs font-bold text-white">
                    {m.initials}
                  </span>
                  <div className="min-w-0 flex-1">
                    <p className="truncate text-xs font-semibold text-stone-900">{m.name}</p>
                    <RoleBadge role={m.role} size="sm" />
                  </div>
                </li>
              ))}
            </ul>
            <Button variant="ghost" size="sm" fullWidth className="mt-3 justify-start">+ Inviter</Button>
          </Card>

          <Card>
            <p className="text-2xs font-semibold uppercase tracking-wider text-stone-500">Raccourcis</p>
            <ul className="mt-2 space-y-1 text-xs text-stone-600">
              <li><kbd className="rounded border border-stone-300 bg-stone-50 px-1.5 font-mono">1-7</kbd> Onglets</li>
              <li><kbd className="rounded border border-stone-300 bg-stone-50 px-1.5 font-mono">G</kbd> Générer rapport</li>
              <li><kbd className="rounded border border-stone-300 bg-stone-50 px-1.5 font-mono">E</kbd> Exporter</li>
              <li><kbd className="rounded border border-stone-300 bg-stone-50 px-1.5 font-mono">/</kbd> Recherche globale</li>
            </ul>
          </Card>
        </aside>
      </div>
    </div>
  );
}
