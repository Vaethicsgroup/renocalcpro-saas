// app/[locale]/(public)/contact/page.tsx — Contact + démo v2.0

import { setRequestLocale } from "next-intl/server";

interface Props { params: Promise<{ locale: string }> }

export default async function ContactPage({ params }: Props) {
  const { locale } = await params;
  setRequestLocale(locale);
  return (
    <main className="bg-cream-50 pb-24">
      <header className="mx-auto max-w-4xl px-6 pt-16 text-center md:pt-20">
        <div className="inline-flex items-center gap-2 rounded-full border border-forest-200 bg-white/70 px-3 py-1.5 text-xs font-semibold uppercase tracking-wider text-forest-700">
          <span aria-hidden className="h-1.5 w-1.5 rounded-full bg-forest-500" />
          Contact & démo
        </div>
        <h1
          className="mt-4 font-serif text-4xl font-bold leading-tight tracking-tight text-forest-900 md:text-5xl lg:text-6xl"
          style={{ fontFamily: "Source Serif 4, Georgia, serif" }}
        >
          Parlons de votre projet
        </h1>
        <p className="mt-5 text-lg leading-relaxed text-forest-900/70">
          Notre équipe vous répond sous 24 h ouvrées. Démo personnalisée sur demande.
        </p>
      </header>

      <div className="mx-auto mt-12 grid max-w-6xl gap-8 px-6 lg:grid-cols-[1.4fr_1fr]">
        {/* Formulaire */}
        <section className="rounded-2xl border border-cream-300 bg-white p-8 shadow-card">
          <h2
            className="font-serif text-2xl font-bold text-forest-900"
            style={{ fontFamily: "Source Serif 4, Georgia, serif" }}
          >
            Envoyez-nous un message
          </h2>
          <form className="mt-6 grid gap-5 sm:grid-cols-2">
            <Field label="Prénom" htmlFor="firstname" required>
              <input id="firstname" name="firstname" type="text" autoComplete="given-name" required
                className="h-10 w-full rounded-lg border border-cream-400 bg-white px-3.5 text-sm text-forest-900 focus:border-forest-600 focus:outline-none focus:ring-2 focus:ring-forest-200/40" />
            </Field>
            <Field label="Nom" htmlFor="lastname" required>
              <input id="lastname" name="lastname" type="text" autoComplete="family-name" required
                className="h-10 w-full rounded-lg border border-cream-400 bg-white px-3.5 text-sm text-forest-900 focus:border-forest-600 focus:outline-none focus:ring-2 focus:ring-forest-200/40" />
            </Field>
            <Field label="Email" htmlFor="email" required className="sm:col-span-2">
              <input id="email" name="email" type="email" autoComplete="email" required
                className="h-10 w-full rounded-lg border border-cream-400 bg-white px-3.5 text-sm text-forest-900 focus:border-forest-600 focus:outline-none focus:ring-2 focus:ring-forest-200/40" />
            </Field>
            <Field label="Société (optionnel)" htmlFor="company" className="sm:col-span-2">
              <input id="company" name="company" type="text" autoComplete="organization"
                className="h-10 w-full rounded-lg border border-cream-400 bg-white px-3.5 text-sm text-forest-900 focus:border-forest-600 focus:outline-none focus:ring-2 focus:ring-forest-200/40" />
            </Field>
            <Field label="Type de demande" htmlFor="topic" required className="sm:col-span-2">
              <select id="topic" name="topic" required
                className="h-10 w-full rounded-lg border border-cream-400 bg-white px-3.5 text-sm text-forest-900 focus:border-forest-600 focus:outline-none focus:ring-2 focus:ring-forest-200/40">
                <option value="">— Sélectionner —</option>
                <option value="demo">Demande de démo personnalisée</option>
                <option value="pricing">Tarifs Entreprise / sur devis</option>
                <option value="partnership">Partenariat</option>
                <option value="press">Presse / journalistes</option>
                <option value="support">Support technique (compte existant)</option>
                <option value="other">Autre</option>
              </select>
            </Field>
            <Field label="Votre message" htmlFor="message" required className="sm:col-span-2">
              <textarea id="message" name="message" rows={5} required
                placeholder="Décrivez votre projet, votre équipe, vos enjeux…"
                className="w-full rounded-lg border border-cream-400 bg-white px-3.5 py-2 text-sm text-forest-900 focus:border-forest-600 focus:outline-none focus:ring-2 focus:ring-forest-200/40" />
            </Field>
            <div className="sm:col-span-2">
              <label className="flex items-start gap-2 text-xs text-forest-900/70">
                <input type="checkbox" required className="mt-0.5 accent-forest-700" />
                J'accepte que mes données soient traitées conformément à la
                {" "}
                <a href={`/${locale}/legal/privacy`} className="font-semibold text-forest-700 hover:text-forest-800 hover:underline">politique de confidentialité</a>.
              </label>
            </div>
            <button type="submit"
              className="sm:col-span-2 inline-flex h-12 items-center justify-center rounded-lg bg-forest-700 px-6 text-base font-semibold text-cream-50 shadow-sm transition hover:bg-forest-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-forest-400 focus-visible:ring-offset-2">
              Envoyer ma demande
            </button>
          </form>
        </section>

        {/* Sidebar contacts */}
        <aside className="space-y-4">
          <ContactCard
            icon="✉"
            title="Email"
            primary="contact@renocalcpro.fr"
            href="mailto:contact@renocalcpro.fr"
          />
          <ContactCard
            icon="📞"
            title="Téléphone"
            primary="+33 4 XX XX XX XX"
            secondary="Lun-Ven 9h-18h"
          />
          <ContactCard
            icon="📍"
            title="Adresse"
            primary="Réno·Calc Pro"
            secondary="38000 Grenoble · France"
          />
          <ContactCard
            icon="🛡️"
            title="DPO RGPD"
            primary="dpo@renocalcpro.fr"
            href="mailto:dpo@renocalcpro.fr"
          />
          <ContactCard
            icon="📰"
            title="Presse"
            primary="presse@renocalcpro.fr"
            href="mailto:presse@renocalcpro.fr"
          />
        </aside>
      </div>
    </main>
  );
}

function Field({ label, htmlFor, required, className = "", children }: { label: string; htmlFor: string; required?: boolean; className?: string; children: React.ReactNode }) {
  return (
    <div className={`flex flex-col gap-1.5 ${className}`}>
      <label htmlFor={htmlFor} className="text-sm font-medium text-stone-900">
        {label}{required && <span aria-hidden className="ml-0.5 text-error-600">*</span>}
      </label>
      {children}
    </div>
  );
}

function ContactCard({ icon, title, primary, secondary, href }: { icon: string; title: string; primary: string; secondary?: string; href?: string }) {
  const Inner = (
    <>
      <span aria-hidden className="text-2xl">{icon}</span>
      <div>
        <p className="text-xs font-semibold uppercase tracking-wider text-stone-500">{title}</p>
        <p className="text-sm font-semibold text-stone-900">{primary}</p>
        {secondary && <p className="text-xs text-stone-600">{secondary}</p>}
      </div>
    </>
  );
  return href ? (
    <a href={href} className="flex items-start gap-3 rounded-xl border border-stone-200 bg-white p-4 shadow-soft hover:border-teal-300">
      {Inner}
    </a>
  ) : (
    <div className="flex items-start gap-3 rounded-xl border border-stone-200 bg-white p-4 shadow-soft">{Inner}</div>
  );
}

export const metadata = {
  title: "Contact — Réno·Calc Pro",
  description: "Contactez l'équipe Réno·Calc Pro pour une démo, un devis ou toute question.",
};
