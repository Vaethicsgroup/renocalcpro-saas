// components/layout/SidebarParticulier.tsx — Sidebar espace particulier v3.0 (Sprint v2.4)
// Fond cream chaleureux + logo officiel + items rounded-lg + accent forest.

"use client";

import Link from "next/link";
import { usePathname } from "next/navigation";
import { useState } from "react";
import { Logo } from "@/components/ui/Logo";

interface Props { locale: string }

const NAV = [
  { href: "/p/dashboard", icon: "🏠", label: "Tableau de bord" },
  { href: "/p/projects",  icon: "📁", label: "Mes projets" },
  { href: "/p/aids",      icon: "💶", label: "Mes aides" },
  { href: "/p/documents", icon: "📄", label: "Documents" },
  { href: "/p/account",   icon: "⚙️", label: "Mon compte" },
];

export function SidebarParticulier({ locale }: Props) {
  const pathname = usePathname();
  const [open, setOpen] = useState(false);

  function isActive(href: string) {
    return pathname?.includes(href);
  }

  const navItems = (
    <ul className="space-y-1">
      {NAV.map(n => {
        const active = isActive(n.href);
        return (
          <li key={n.href}>
            <Link
              href={`/${locale}${n.href}`}
              onClick={() => setOpen(false)}
              aria-current={active ? "page" : undefined}
              className={[
                "flex items-center gap-3 rounded-xl px-3.5 py-2.5 text-sm font-medium transition-colors",
                active
                  ? "bg-white text-forest-800 shadow-card"
                  : "text-forest-900/80 hover:bg-white/70 hover:text-forest-800",
              ].join(" ")}
            >
              <span aria-hidden className="text-lg">{n.icon}</span>
              <span>{n.label}</span>
            </Link>
          </li>
        );
      })}
    </ul>
  );

  return (
    <>
      {/* Hamburger mobile */}
      <button
        type="button"
        onClick={() => setOpen(true)}
        aria-label="Ouvrir le menu"
        className="fixed left-3 top-3 z-30 inline-flex h-10 w-10 items-center justify-center rounded-lg border border-cream-300 bg-white shadow-card md:hidden"
      >
        <svg viewBox="0 0 24 24" className="h-5 w-5 text-forest-800" fill="none" stroke="currentColor" strokeWidth="2">
          <path strokeLinecap="round" strokeLinejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>

      {/* Backdrop mobile */}
      {open && (
        <div className="fixed inset-0 z-30 bg-forest-900/40 backdrop-blur-sm md:hidden" onClick={() => setOpen(false)} aria-hidden />
      )}

      {/* Sidebar */}
      <aside
        aria-label="Navigation espace particulier"
        className={[
          "fixed inset-y-0 left-0 z-40 flex w-64 flex-col border-r border-cream-300 bg-cream-200 p-5 transition-transform md:static md:translate-x-0",
          open ? "translate-x-0" : "-translate-x-full md:translate-x-0",
        ].join(" ")}
      >
        {/* Header sidebar avec LOGO officiel */}
        <div className="mb-6 flex items-center justify-between">
          <Logo href={`/${locale}/p/dashboard`} variant="wordmark" theme="dark" className="text-base" />
          <button
            type="button"
            onClick={() => setOpen(false)}
            aria-label="Fermer le menu"
            className="rounded-lg p-1 text-forest-900/60 hover:bg-white/60 md:hidden"
          >
            ✕
          </button>
        </div>

        {/* Badge espace */}
        <div className="mb-4 inline-flex w-fit items-center gap-1.5 rounded-full bg-white/70 px-3 py-1 text-2xs font-semibold uppercase tracking-wider text-forest-700">
          <span className="inline-block h-1.5 w-1.5 rounded-full bg-forest-500" />
          Espace particulier
        </div>

        {/* Navigation */}
        <nav className="flex-1" aria-label="Sections">{navItems}</nav>

        {/* Carte aide */}
        <div className="mt-6 rounded-2xl border border-cream-300 bg-white p-4 text-center shadow-card">
          <p className="text-2xl" aria-hidden>💬</p>
          <p className="mt-2 text-sm font-semibold text-forest-900">Besoin d'aide ?</p>
          <p className="mt-1 text-xs text-stone-600">Nos conseillers vous accompagnent à chaque étape.</p>
          <Link
            href={`/${locale}/contact`}
            className="mt-3 inline-flex w-full items-center justify-center rounded-lg border border-cream-400 px-3 py-2 text-xs font-semibold text-forest-800 hover:bg-cream-100"
          >
            Nous contacter →
          </Link>
        </div>
      </aside>
    </>
  );
}
