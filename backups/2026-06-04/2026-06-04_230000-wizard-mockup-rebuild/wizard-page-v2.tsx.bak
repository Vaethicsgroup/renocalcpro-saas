}

function StepScenarios({
  form,
  updateScenario,
}: {
  form: BuildingFormData;
  updateScenario: (
    key: keyof BuildingFormData["scenariosEnabled"],
    value: boolean,
  ) => void;
}) {
  const options: ReadonlyArray<{
    key: keyof BuildingFormData["scenariosEnabled"];
    title: string;
    desc: string;
  }> = [
    {
      key: "isolationOnly",
      title: "Bouquet isolation seule",
      desc: "Murs, toiture, plancher — sans toucher au chauffage.",
    },
    {
      key: "heatingOnly",
      title: "Remplacement du chauffage seul",
      desc: "Substitution équipement, isolation existante conservée.",
    },
    {
      key: "global",
      title: "Rénovation globale",
      desc: "Isolation + chauffage + ventilation — saut DPE maximal.",
    },
  ];

  const atLeastOne =
    form.scenariosEnabled.isolationOnly ||
    form.scenariosEnabled.heatingOnly ||
    form.scenariosEnabled.global;

  return (
    <Card>
      <CardHeader>
        <CardTitle>Scénarios à comparer</CardTitle>
        <CardDescription>
          Sélectionnez au moins un bouquet de travaux à simuler — vous verrez le
          coût, les aides, le ROI et l&apos;étiquette DPE atteinte.
        </CardDescription>
      </CardHeader>
      <CardContent>
        <div className="space-y-2">
          {options.map((opt) => {
            const checked = form.scenariosEnabled[opt.key];
            return (
              <label
                key={opt.key}
                className={[
                  "flex cursor-pointer items-start gap-3 rounded-lg border p-4 transition-colors",
                  checked
                    ? "border-forest-300 bg-forest-50/50"
                    : "border-cream-300 bg-white hover:border-forest-300",
                ].join(" ")}
              >
                <input
                  type="checkbox"
                  checked={checked}
                  onChange={(e) => updateScenario(opt.key, e.target.checked)}
                  className="mt-0.5 h-4 w-4 rounded border-cream-300 text-forest-600 accent-forest-600"
                />
                <div className="min-w-0">
                  <p className="text-sm font-semibold text-night-800">
                    {opt.title}
                  </p>
                  <p className="mt-0.5 text-xs leading-relaxed text-stone-600">
                    {opt.desc}
                  </p>
                </div>
              </label>
            );
          })}
        </div>
        {!atLeastOne && (
          <p className="mt-3 inline-flex items-center gap-1.5 text-xs text-amber-700">
            <AlertTriangle className="h-3.5 w-3.5" strokeWidth={1.75} aria-hidden />
            Sélectionnez au moins un scénario.
          </p>
        )}
      </CardContent>
    </Card>
  );
}

function StepReview({
  form,
  location,
  submit,
  isPending,
}: {
  form: BuildingFormData;
  location: LocationState;
  submit: SubmitState;
  isPending: boolean;
}) {
  const buildingTypeLabel =
    BUILDING_TYPES.find((t) => t.value === form.buildingType)?.label ??
    form.buildingType;
  const heatingLabel =
    HEATINGS.find((h) => h.value === form.heatingKind)?.label ??
    form.heatingKind;
  const dhwLabel =
    DHWS.find((d) => d.value === form.dhwKind)?.label ?? form.dhwKind;
  const ventLabel =
    VENTILATIONS.find((v) => v.value === form.ventilationKind)?.label ??
    form.ventilationKind;

  const scenariosCount =
    (form.scenariosEnabled.isolationOnly ? 1 : 0) +
    (form.scenariosEnabled.heatingOnly ? 1 : 0) +
    (form.scenariosEnabled.global ? 1 : 0);

  return (
    <Card>
      <CardHeader>
        <CardTitle>Récapitulatif</CardTitle>
        <CardDescription>
          Vérifiez vos saisies puis lancez le calcul.
        </CardDescription>
      </CardHeader>
      <CardContent>
        <dl className="grid gap-3 sm:grid-cols-2">
          <ReviewItem label="Projet" value={form.projectName} />
          <ReviewItem
            label="Adresse"
            value={
              location.addressLabel ||
              `${location.postalCode} ${location.city}`.trim() ||
              "—"
            }
          />
          <ReviewItem
            label="Zone climatique"
            value={CLIMATE_ZONE_LABELS_FR[form.climateZone]}
          />
          <ReviewItem label="Type" value={buildingTypeLabel} />
          <ReviewItem label="Surface" value={`${form.surfaceHabitableM2} m²`} />
          <ReviewItem
            label="Hauteur"
            value={`${form.hauteurSousPlafondM} m`}
          />
          <ReviewItem
            label="Murs / Toiture / Plancher"
            value={`${form.wallSurfaceM2} / ${form.roofSurfaceM2} / ${form.floorSurfaceM2} m²`}
          />
          <ReviewItem
            label="Vitres"
            value={`${form.windowSurfaceM2} m²`}
          />
          <ReviewItem label="Chauffage" value={heatingLabel} />
          <ReviewItem label="ECS" value={dhwLabel} />
          <ReviewItem label="Ventilation" value={ventLabel} />
          <ReviewItem
            label="Occupants / Foyer fiscal"
            value={`${form.occupants} / ${form.householdSize}`}
          />
          <ReviewItem
            label="Scénarios"
            value={`${scenariosCount} sélectionné${scenariosCount > 1 ? "s" : ""}`}
          />
        </dl>

        {submit.status === "error" && (
          <div
            role="status"
            className="mt-4 flex items-start gap-2 rounded-md border border-error-100 bg-error-50 p-3 text-sm text-error-700"
          >
            <AlertTriangle
              className="mt-0.5 h-4 w-4 shrink-0"
              strokeWidth={1.75}
              aria-hidden
            />
            <div>
              <p className="font-semibold">Calcul impossible</p>
              <p className="mt-0.5">{submit.message}</p>
              {submit.fieldErrors && submit.fieldErrors.length > 0 && (
                <ul className="mt-2 list-inside list-disc space-y-1 text-xs">
                  {submit.fieldErrors.map((fe, i) => (
                    <li key={i}>
                      <span className="font-medium">{fe.field}</span> — {fe.message}
                    </li>
                  ))}
                </ul>
              )}
            </div>
          </div>
        )}

        {(isPending || submit.status === "submitting") && (
          <div className="mt-4 flex items-center gap-2 rounded-md bg-cream-100 p-3 text-sm text-stone-700">
            <Loader2
              className="h-4 w-4 animate-spin text-forest-600"
              strokeWidth={2}
              aria-hidden
            />
            Calcul en cours, le moteur thermique analyse votre saisie…
          </div>
        )}
      </CardContent>
    </Card>
  );
}

function ReviewItem({ label, value }: { label: string; value: string }) {
  return (
    <div className="rounded-md border border-cream-200 bg-cream-50/50 p-3">
      <dt className="text-2xs font-semibold uppercase tracking-wider text-stone-500">
        {label}
      </dt>
      <dd className="mt-0.5 text-sm font-semibold text-night-800">{value}</dd>
    </div>
  );
}

// ─── Result view (rendu inline après submit success) ───────────────────────

function ResultView({
  locale,
  form,
  result,
}: {
  locale: string;
  form: BuildingFormData;
  result: ProjectResult;
}) {
  const fmt = (n: number) =>
    n.toLocaleString("fr-FR", { maximumFractionDigits: 0 });

  return (
    <div className="relative min-h-screen bg-cream-50 pb-16 pt-6 sm:pt-10">
      <div
        aria-hidden
        className="pointer-events-none absolute inset-x-0 top-0 h-[400px] overflow-hidden"
      >
        <div className="absolute -top-32 left-1/2 h-72 w-[600px] -translate-x-1/2 rounded-full bg-forest-100/40 blur-3xl sm:h-96 sm:w-[800px]" />
      </div>

      <div className="relative mx-auto max-w-3xl px-4 sm:px-6">
        <header className="mb-6 text-center">
          <p className="inline-flex items-center gap-2 rounded-full border border-forest-200 bg-forest-100/70 px-3 py-1.5 text-2xs font-semibold uppercase tracking-wider text-forest-700">
            <Check className="h-3 w-3" strokeWidth={2.5} aria-hidden />
            Diagnostic calculé
          </p>
          <h1
            className="mt-3 font-serif text-2xl font-bold tracking-tight text-night-800 sm:text-3xl md:text-4xl"
            style={{ fontFamily: "Source Serif 4, Georgia, serif" }}
          >
            {form.projectName}
          </h1>
          <p className="mt-2 text-sm text-stone-600">
            Engine v{result.engine_version} · Paramètres v
            {result.parameters_version} ·{" "}
            {new Date(result.computed_at).toLocaleString("fr-FR")}
          </p>
        </header>

        {/* DPE + GES */}
        <Card>
          <CardHeader>
            <CardTitle>État initial estimé</CardTitle>
            <CardDescription>
              Calcul moteur réel sur la base de vos saisies.
            </CardDescription>
          </CardHeader>
          <CardContent>
            <div className="grid gap-4 sm:grid-cols-2">
              <div className="rounded-lg border border-cream-300 bg-white p-4 text-center">
                <p className="text-2xs font-semibold uppercase tracking-wider text-stone-500">
                  Étiquette DPE
                </p>
                <div className="mt-2 flex justify-center">
                  <DPELabel
                    classification={result.baseline.dpe_label}
                    size="lg"
                  />
                </div>
              </div>
              <div className="rounded-lg border border-cream-300 bg-white p-4 text-center">
                <p className="text-2xs font-semibold uppercase tracking-wider text-stone-500">
                  Étiquette GES
                </p>
                <div className="mt-2 flex justify-center">
                  <DPELabel
                    classification={result.baseline.ges_label}
                    size="lg"
                  />
                </div>
              </div>
              <KpiBlock
                label="Besoin chauffage / an"
                value={`${fmt(result.baseline.heating_needs_kWh_year)} kWh`}
              />
              <KpiBlock
                label="Besoin ECS / an"
                value={`${fmt(result.baseline.dhw_needs_kWh_year)} kWh`}
              />
              <KpiBlock
                label="UA"
                value={`${fmt(result.baseline.UA_W_K)} W/K`}
              />
              <KpiBlock
                label="Cep"
                value={`${fmt(result.baseline.cep_kWh_m2_year)} kWh EP/m²/an`}
              />
            </div>
          </CardContent>
        </Card>

        {/* Scénarios */}
        {result.scenarios.length > 0 && (
          <Card className="mt-4">
            <CardHeader>
              <CardTitle>Scénarios travaux</CardTitle>
              <CardDescription>
                {result.scenarios.length} scénario
                {result.scenarios.length > 1 ? "s" : ""} chiffré
                {result.scenarios.length > 1 ? "s" : ""} par le moteur.
              </CardDescription>
            </CardHeader>
            <CardContent>
              <div className="space-y-3">
                {result.scenarios.map((s) => (
                  <div
                    key={s.scenario_id}
                    className={[
                      "rounded-lg border p-4",
                      s.scenario_id === result.recommended_scenario_id
                        ? "border-forest-300 bg-forest-50/50"
                        : "border-cream-300 bg-white",
                    ].join(" ")}
                  >
                    <div className="flex items-center justify-between gap-2">
                      <p className="font-semibold text-night-800">
                        {s.scenario_name}
                      </p>
                      {s.scenario_id === result.recommended_scenario_id && (
                        <span className="inline-flex items-center gap-1 rounded-full bg-forest-100 px-2 py-0.5 text-2xs font-semibold text-forest-800">
                          <Sparkles
                            className="h-3 w-3"
                            strokeWidth={2}
                            aria-hidden
                          />
                          Recommandé
                        </span>
                      )}
                    </div>
                    <dl className="mt-3 grid grid-cols-2 gap-2 text-xs sm:grid-cols-4">
                      <ScenarioStat
                        label="DPE après"
                        value={s.after.dpe_label}
                      />
                      <ScenarioStat
                        label="Économies"
                        value={`${fmt(s.savings.energy_eur_year)} €/an`}
                      />
                      <ScenarioStat
                        label="Coût"
                        value={`${fmt(s.works_cost_eur)} €`}
                      />
                      <ScenarioStat
                        label="Aides"
                        value={`${fmt(s.aids.total_subsidy_eur)} €`}
                      />
                    </dl>
                  </div>
                ))}
              </div>
            </CardContent>
          </Card>
        )}

        {/* Warnings */}
        {result.warnings.length > 0 && (
          <Card className="mt-4">
            <CardHeader>
              <CardTitle>Points de vigilance</CardTitle>
              <CardDescription>
                Hypothèses ou cas particuliers détectés par le moteur.
              </CardDescription>
            </CardHeader>
            <CardContent>
              <ul className="space-y-2 text-sm">
                {result.warnings.map((w) => (
                  <li
                    key={w.code}
                    className="flex items-start gap-2 rounded-md border-l-4 border-amber-400 bg-amber-50/60 px-3 py-2 text-amber-900"
                  >
                    <AlertTriangle
                      className="mt-0.5 h-4 w-4 shrink-0 text-amber-600"
                      strokeWidth={1.75}
                      aria-hidden
                    />
                    <span>
                      <span className="font-semibold">[{w.severity}]</span>{" "}
                      {w.message}
                    </span>
                  </li>
                ))}
              </ul>
            </CardContent>
          </Card>
        )}

        {/* CTA — voir détail + créer un nouveau */}
        <div className="mt-6 flex flex-wrap items-center justify-between gap-3">
          <Link
            href={`/${locale}/p/dashboard`}
            className="inline-flex h-11 items-center justify-center rounded-lg border border-cream-300 bg-white px-4 text-sm font-semibold text-stone-700 transition-colors hover:bg-cream-50"
          >
            Retour au tableau de bord
          </Link>
          <Link
            href={`/${locale}/p/projects/${encodeURIComponent(form.projectName)}/synthese`}
            className="inline-flex h-11 items-center justify-center gap-2 rounded-lg bg-forest-600 px-5 text-sm font-semibold text-white shadow-soft transition-colors hover:bg-forest-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-forest-400 focus-visible:ring-offset-2"
          >
            Voir la synthèse complète
            <ArrowRight className="h-4 w-4" strokeWidth={2} aria-hidden />
          </Link>
        </div>
      </div>
    </div>
  );
}

function KpiBlock({ label, value }: { label: string; value: string }) {
  return (
    <div className="rounded-lg border border-cream-300 bg-white p-3">
      <p className="text-2xs font-semibold uppercase tracking-wider text-stone-500">
        {label}
      </p>
      <p className="mt-1 text-sm font-semibold text-night-800 tabular-nums">
        {value}
      </p>
    </div>
  );
}

function ScenarioStat({ label, value }: { label: string; value: string }) {
  return (
    <div>
      <p className="text-2xs font-semibold uppercase tracking-wider text-stone-500">
        {label}
      </p>
      <p className="mt-0.5 font-semibold text-night-800">{value}</p>
    </div>
  );
}
