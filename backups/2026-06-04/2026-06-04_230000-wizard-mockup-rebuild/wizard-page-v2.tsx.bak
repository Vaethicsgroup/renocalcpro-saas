}

function StepSystems({ form, updateForm }: StepProps) {
  return (
    <Card>
      <CardHeader>
        <CardTitle>Systèmes techniques</CardTitle>
        <CardDescription>
          Chauffage, eau chaude et ventilation présents aujourd&apos;hui.
        </CardDescription>
      </CardHeader>
      <CardContent>
        <div className="grid gap-4">
          <FormField label="Chauffage principal" htmlFor="heatingKind" required>
            <Select
              id="heatingKind"
              value={form.heatingKind}
              onChange={(e) =>
                updateForm(
                  "heatingKind",
                  e.target.value as BuildingFormData["heatingKind"],
                )
              }
            >
              {HEATINGS.map((h) => (
                <option key={h.value} value={h.value}>
                  {h.label}
