const DHWS: ReadonlyArray<{
  value: BuildingFormData["dhwKind"];
  label: string;
}> = [
  { value: "BALLON_ELEC",            label: "Ballon électrique" },
  { value: "BALLON_THERMODYN",       label: "Ballon thermodynamique" },
