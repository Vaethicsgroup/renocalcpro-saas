            <input
              type="checkbox"
              checked={form.householdIdf}
              onChange={(e) => updateForm("householdIdf", e.target.checked)}
              className="mt-0.5 h-4 w-4 rounded border-cream-300 text-forest-600 accent-forest-600"
            />
            <span className="text-stone-700">
              <span className="font-medium text-night-800">
                Logement situé en Île-de-France
              </span>
              <span className="ml-1 text-stone-600">
                — barèmes MaPrimeRénov&apos; différents.
              </span>
