              min={1}
              max={15}
              value={form.householdSize}
              onChange={(e) =>
                updateForm("householdSize", Number(e.target.value))
              }
            />
          </FormField>
          <FormField
            label="Revenu fiscal de référence (optionnel)"
            htmlFor="householdRfrEur"
            helper="En euros — utilisé pour estimer MaPrimeRénov'."
          >
            <Input
              id="householdRfrEur"
              type="number"
