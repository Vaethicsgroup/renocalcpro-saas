  { value: "VMC_SF_AUTO",     label: "VMC simple flux autoréglable" },
  { value: "VMC_SF_HYGRO_A",  label: "VMC simple flux hygro A" },
  { value: "VMC_SF_HYGRO_B",  label: "VMC simple flux hygro B" },
  { value: "VMC_DF",          label: "VMC double flux" },
  { value: "VMI",             label: "VMI (insufflation)" },
];

// ─── État submit ───────────────────────────────────────────────────────────

type SubmitState =
  | { status: "idle" }
  | { status: "submitting" }
  | { status: "error"; message: string; fieldErrors?: Array<{ field: string; message: string }> }
  | { status: "success"; result: ProjectResult };

// ─── Page Wizard ───────────────────────────────────────────────────────────

const INITIAL_LOCATION: LocationState = {
  addressLabel: "",
  postalCode: "",
  city: "",
  latitude: null,
  longitude: null,
};

export default function NewProjectWizardPage() {
  const locale = useLocale();
  const [step, setStep] = useState(0);
  const [form, setForm] = useState<BuildingFormData>(INITIAL_FORM);
  const [location, setLocation] = useState<LocationState>(INITIAL_LOCATION);
  const [submit, setSubmit] = useState<SubmitState>({ status: "idle" });
  const [isPending, startTransition] = useTransition();

  /**
   * Sélectionne une adresse depuis l'autocomplete BAN : remplit l'état de
   * localisation ET déduit la zone climatique depuis le code postal.
   */
  const handleAddressSelect = (feature: BanFeature) => {
    setLocation({
      addressLabel: feature.label,
      postalCode: feature.postcode ?? "",
      city: feature.city ?? "",
      latitude: feature.latitude,
      longitude: feature.longitude,
    });
    const deducedZone = climateZoneFromPostalCode(feature.postcode);
    if (deducedZone) {
      setForm((prev) => ({ ...prev, climateZone: deducedZone }));
    }
  };

  /** Permet la saisie manuelle d'un code postal (déduction climateZone + reset coords). */
  const handlePostalChange = (postalCode: string) => {
    setLocation((prev) => ({ ...prev, postalCode }));
    const deducedZone = climateZoneFromPostalCode(postalCode);
    if (deducedZone) {
      setForm((prev) => ({ ...prev, climateZone: deducedZone }));
    }
  };

  /** Géolocalisation navigateur → reverse geocoding BAN → remplissage. */
  const handleGeolocate = async (): Promise<void> => {
    if (typeof navigator === "undefined" || !navigator.geolocation) return;
    return new Promise((resolve) => {
      navigator.geolocation.getCurrentPosition(
        async (pos) => {
          const lat = pos.coords.latitude;
          const lon = pos.coords.longitude;
          const feature = await reverseGeocode(lat, lon);
          if (feature) {
            handleAddressSelect(feature);
          } else {
            setLocation((prev) => ({
              ...prev,
              latitude: lat,
              longitude: lon,
            }));
          }
          resolve();
        },
        () => resolve(),
        { enableHighAccuracy: true, timeout: 8000, maximumAge: 60000 },
      );
    });
  };

  const updateForm = <K extends keyof BuildingFormData>(
    key: K,
    value: BuildingFormData[K],
  ) => {
    setForm((prev) => ({ ...prev, [key]: value }));
  };

  const updateScenario = (
    key: keyof BuildingFormData["scenariosEnabled"],
    value: boolean,
  ) => {
    setForm((prev) => ({
      ...prev,
      scenariosEnabled: { ...prev.scenariosEnabled, [key]: value },
    }));
  };

  const handleNext = () => {
    if (step < STEPS.length - 1) setStep(step + 1);
  };
  const handlePrev = () => {
    if (step > 0) setStep(step - 1);
  };

  const handleSubmit = () => {
    startTransition(async () => {
      setSubmit({ status: "submitting" });
      try {
        // organizationId et projectId optionnels : si absents → calcul sans
        // persistance (fail-soft).
        const res: ComputeFromFormResult = await computeFromForm(form);
        if (res.ok) {
          setSubmit({ status: "success", result: res.result });
        } else {
          setSubmit({
            status: "error",
            message: res.error,
            fieldErrors: res.fieldErrors,
          });
        }
      } catch (err) {
        setSubmit({
          status: "error",
          message:
            err instanceof Error
              ? err.message
              : "Erreur inattendue lors du calcul.",
        });
      }
    });
  };

  // ─── Sticky CTA bar ────────────────────────────────────────────────
  const isLastStep = step === STEPS.length - 1;
  const ctaLabel = isLastStep ? "Calculer mon diagnostic" : "Continuer";
  const ctaIcon = isLastStep ? Sparkles : ArrowRight;
  const CtaIcon = ctaIcon;

  // ─── Result rendering inline (après submit success) ────────────────
  if (submit.status === "success") {
    return <ResultView locale={locale} form={form} result={submit.result} />;
  }

  return (
    <div className="relative min-h-screen bg-cream-50 pb-32 pt-6 sm:pb-24 sm:pt-10">
      {/* Halo discret vert énergie en haut */}
      <div
        aria-hidden
        className="pointer-events-none absolute inset-x-0 top-0 h-[400px] overflow-hidden"
      >
        <div className="absolute -top-32 left-1/2 h-72 w-[600px] -translate-x-1/2 rounded-full bg-forest-100/40 blur-3xl sm:h-96 sm:w-[800px]" />
      </div>

      <div className="relative mx-auto max-w-2xl px-4 sm:px-6">
        {/* Header */}
        <header className="mb-6 text-center">
          <p className="inline-flex items-center gap-2 rounded-full border border-cream-300 bg-white/85 px-3 py-1.5 text-2xs font-semibold uppercase tracking-wider text-forest-700 shadow-soft">
            <span aria-hidden className="h-1.5 w-1.5 rounded-full bg-forest-500" />
            Nouveau diagnostic
          </p>
          <h1
            className="mt-3 font-serif text-2xl font-bold tracking-tight text-night-800 sm:text-3xl md:text-4xl"
            style={{ fontFamily: "Source Serif 4, Georgia, serif" }}
          >
            Décrivez votre logement
          </h1>
          <p className="mt-2 text-sm text-stone-600">
            7 étapes pour obtenir une estimation DPE, des scénarios travaux et
            les aides mobilisables.
          </p>
        </header>

        {/* Stepper compact mobile */}
        <div className="mb-6 overflow-x-auto pb-2">
          <OnboardingStepper
            steps={STEPS.map((s) => ({ key: s.key, label: s.label }))}
            currentStep={step}
          />
        </div>

        {/* Étape courante */}
        <div className="space-y-4">
          {step === 0 && (
            <StepLocation
              location={location}
              form={form}
              onAddressSelect={handleAddressSelect}
              onPostalChange={handlePostalChange}
              onCityChange={(city) =>
                setLocation((prev) => ({ ...prev, city }))
              }
              onAddressTextChange={(text) =>
                setLocation((prev) => ({ ...prev, addressLabel: text }))
              }
              onGeolocate={handleGeolocate}
              updateForm={updateForm}
            />
          )}
          {step === 1 && (
            <StepContext form={form} updateForm={updateForm} />
          )}
          {step === 2 && (
            <StepGeometry form={form} updateForm={updateForm} />
          )}
          {step === 3 && (
            <StepEnvelope form={form} updateForm={updateForm} />
          )}
          {step === 4 && (
            <StepSystems form={form} updateForm={updateForm} />
          )}
          {step === 5 && (
            <StepHousehold form={form} updateForm={updateForm} />
          )}
          {step === 6 && (
            <StepScenarios form={form} updateScenario={updateScenario} />
          )}
          {step === 7 && (
            <StepReview
              form={form}
              location={location}
              submit={submit}
              isPending={isPending}
            />
          )}
        </div>
      </div>

      {/* CTA bar sticky bottom */}
      <div className="fixed inset-x-0 bottom-0 z-30 border-t border-cream-300 bg-white/95 px-4 py-3 shadow-floating backdrop-blur-sm sm:px-6">
        <div className="mx-auto flex max-w-2xl items-center justify-between gap-3">
          {step > 0 ? (
            <Button
              variant="ghost"
              size="md"
              onClick={handlePrev}
              disabled={isPending || submit.status === "submitting"}
              iconLeft={<ArrowLeft className="h-4 w-4" strokeWidth={2} aria-hidden />}
            >
              Retour
            </Button>
          ) : (
            <Link
              href={`/${locale}/p/dashboard`}
              className="inline-flex h-10 items-center justify-center rounded-lg px-4 text-sm font-semibold text-stone-700 transition-colors hover:bg-cream-100"
            >
              Annuler
            </Link>
          )}

          {isLastStep ? (
            <Button
              variant="primary"
              size="md"
              onClick={handleSubmit}
              loading={isPending || submit.status === "submitting"}
              iconRight={<CtaIcon className="h-4 w-4" strokeWidth={2} aria-hidden />}
            >
              {ctaLabel}
            </Button>
          ) : (
            <Button
              variant="primary"
              size="md"
              onClick={handleNext}
              iconRight={<CtaIcon className="h-4 w-4" strokeWidth={2} aria-hidden />}
            >
              {ctaLabel}
            </Button>
          )}
        </div>
      </div>
    </div>
  );
}

// ─── Step components ───────────────────────────────────────────────────────

interface StepProps {
  form: BuildingFormData;
  updateForm: <K extends keyof BuildingFormData>(
    key: K,
    value: BuildingFormData[K],
  ) => void;
}

// ─── Step 0 : Localisation ─────────────────────────────────────────────────

function StepLocation({
  location,
  form,
  onAddressSelect,
  onPostalChange,
  onCityChange,
  onAddressTextChange,
  onGeolocate,
  updateForm,
}: {
  location: LocationState;
  form: BuildingFormData;
  onAddressSelect: (f: BanFeature) => void;
  onPostalChange: (cp: string) => void;
  onCityChange: (city: string) => void;
  onAddressTextChange: (text: string) => void;
  onGeolocate: () => Promise<void>;
  updateForm: StepProps["updateForm"];
}) {
  const [geolocPending, setGeolocPending] = useState(false);

  const handleGeolocClick = async () => {
    setGeolocPending(true);
    try {
      await onGeolocate();
    } finally {
      setGeolocPending(false);
    }
  };

  const deducedZone = form.climateZone;
  const zoneLabel = CLIMATE_ZONE_LABELS_FR[deducedZone];

  return (
    <Card>
      <CardHeader>
        <CardTitle>Localisation du logement</CardTitle>
        <CardDescription>
          Saisissez l&apos;adresse pour déduire automatiquement la zone
          climatique et le climat local.
        </CardDescription>
      </CardHeader>
      <CardContent>
        <div className="space-y-4">
          {/* Bouton géolocalisation */}
          <button
            type="button"
            onClick={handleGeolocClick}
            disabled={geolocPending}
            className="inline-flex h-9 items-center justify-center gap-1.5 rounded-md border border-cream-300 bg-white px-3 text-xs font-semibold text-night-800 shadow-soft transition-colors hover:bg-cream-50 disabled:cursor-wait disabled:opacity-60"
          >
            {geolocPending ? (
              <Loader2
                className="h-3.5 w-3.5 animate-spin text-forest-600"
                strokeWidth={2}
                aria-hidden
              />
            ) : (
              <Locate
                className="h-3.5 w-3.5 text-forest-600"
                strokeWidth={2}
                aria-hidden
              />
            )}
            {geolocPending ? "Localisation…" : "Me localiser"}
          </button>

          <FormField
            label="Adresse"
            htmlFor="address"
            helper="Tapez les premières lettres et choisissez dans la liste, ou utilisez « Me localiser »."
          >
            <AddressAutocomplete
              id="address"
              value={location.addressLabel}
              onChange={onAddressTextChange}
              onSelect={onAddressSelect}
            />
          </FormField>

          <div className="grid gap-4 sm:grid-cols-2">
            <FormField
              label="Code postal"
              htmlFor="postalCode"
              required
              helper="5 chiffres — sert à déduire la zone climatique."
            >
              <Input
                id="postalCode"
                type="text"
                inputMode="numeric"
                maxLength={5}
                value={location.postalCode}
                onChange={(e) => onPostalChange(e.target.value)}
                placeholder="ex : 33000"
              />
            </FormField>
            <FormField label="Commune" htmlFor="city">
              <Input
                id="city"
                type="text"
                value={location.city}
                onChange={(e) => onCityChange(e.target.value)}
                placeholder="ex : Bordeaux"
              />
            </FormField>
          </div>

          <FormField
            label="Zone climatique"
            htmlFor="climateZone"
            helper="Déduite du code postal. Vous pouvez la modifier."
          >
            <Select
              id="climateZone"
              value={form.climateZone}
              onChange={(e) =>
                updateForm(
                  "climateZone",
                  e.target.value as BuildingFormData["climateZone"],
                )
              }
            >
              {(Object.keys(CLIMATE_ZONE_LABELS_FR) as Array<
                BuildingFormData["climateZone"]
              >).map((z) => (
                <option key={z} value={z}>
                  {CLIMATE_ZONE_LABELS_FR[z]}
                </option>
              ))}
            </Select>
          </FormField>

          {/* Récap géolocalisation */}
          {location.latitude !== null && location.longitude !== null && (
            <div className="rounded-md border border-forest-200 bg-forest-50/50 p-3">
              <div className="flex items-start gap-2">
                <MapPin
                  className="mt-0.5 h-4 w-4 shrink-0 text-forest-700"
                  strokeWidth={1.75}
                  aria-hidden
                />
                <div className="text-xs text-night-800">
                  <p className="font-semibold">
                    Géolocalisation détectée
                  </p>
                  <p className="mt-0.5 text-stone-600">
                    {location.latitude.toFixed(5)}, {location.longitude.toFixed(5)}{" "}
                    · Zone {zoneLabel}
                  </p>
                </div>
              </div>
              {/* Mini-aperçu carte (image statique OpenStreetMap) */}
              <div className="mt-2 overflow-hidden rounded-md border border-cream-300 bg-white">
                <iframe
                  title="Aperçu localisation"
                  className="block h-32 w-full"
                  src={`https://www.openstreetmap.org/export/embed.html?bbox=${location.longitude - 0.005},${location.latitude - 0.003},${location.longitude + 0.005},${location.latitude + 0.003}&layer=mapnik&marker=${location.latitude},${location.longitude}`}
                  loading="lazy"
                  referrerPolicy="no-referrer-when-downgrade"
                />
              </div>
            </div>
          )}
        </div>
      </CardContent>
    </Card>
  );
}

function StepContext({ form, updateForm }: StepProps) {
  return (
    <Card>
      <CardHeader>
        <CardTitle>Identification &amp; contexte</CardTitle>
        <CardDescription>
          Donnez un nom à votre projet et précisez le contexte général du
          logement.
        </CardDescription>
      </CardHeader>
      <CardContent>
        <div className="grid gap-4">
          <FormField label="Nom du projet" htmlFor="projectName" required>
            <Input
              id="projectName"
              value={form.projectName}
              onChange={(e) => updateForm("projectName", e.target.value)}
              placeholder="Ex : Maison Limoges"
            />
          </FormField>
          <FormField label="Type de bâtiment" htmlFor="buildingType" required>
            <Select
              id="buildingType"
              value={form.buildingType}
              onChange={(e) =>
                updateForm("buildingType", e.target.value as BuildingFormData["buildingType"])
              }
            >
              {BUILDING_TYPES.map((t) => (
                <option key={t.value} value={t.value}>
                  {t.label}
                </option>
              ))}
            </Select>
          </FormField>
          <FormField
            label="Période de construction"
            htmlFor="constructionPeriod"
            required
            helper="Permet d'utiliser les valeurs réglementaires par défaut."
          >
            <Select
              id="constructionPeriod"
              value={form.constructionPeriod}
              onChange={(e) =>
                updateForm(
                  "constructionPeriod",
                  e.target.value as BuildingFormData["constructionPeriod"],
                )
              }
            >
              {PERIODS.map((p) => (
                <option key={p.value} value={p.value}>
                  {p.label}
                </option>
              ))}
            </Select>
          </FormField>
        </div>
      </CardContent>
    </Card>
  );
}

function StepGeometry({ form, updateForm }: StepProps) {
  return (
    <Card>
      <CardHeader>
        <CardTitle>Géométrie du logement</CardTitle>
        <CardDescription>
          Surface habitable et hauteur — les valeurs principales pour le moteur.
        </CardDescription>
      </CardHeader>
      <CardContent>
        <div className="grid gap-4 sm:grid-cols-2">
          <FormField
            label="Surface habitable (m²)"
            htmlFor="surfaceHabitableM2"
            required
          >
            <Input
              id="surfaceHabitableM2"
              type="number"
              min={1}
              max={10000}
              value={form.surfaceHabitableM2}
              onChange={(e) =>
                updateForm("surfaceHabitableM2", Number(e.target.value))
              }
            />
          </FormField>
          <FormField
            label="Hauteur sous plafond (m)"
            htmlFor="hauteurSousPlafondM"
            helper="Approximation OK (défaut 2,5 m)."
          >
            <Input
              id="hauteurSousPlafondM"
              type="number"
              step="0.1"
              min={2}
              max={6}
              value={form.hauteurSousPlafondM}
              onChange={(e) =>
                updateForm("hauteurSousPlafondM", Number(e.target.value))
              }
            />
          </FormField>
          <FormField
            label="Nombre de niveaux"
            htmlFor="niveauCount"
            helper="Combles aménagés inclus."
          >
            <Input
              id="niveauCount"
              type="number"
              min={1}
              max={30}
              value={form.niveauCount}
              onChange={(e) =>
                updateForm("niveauCount", Number(e.target.value))
              }
            />
          </FormField>
          <FormField
            label="Altitude (m)"
            htmlFor="altitudeM"
            helper="Approximation acceptée."
          >
            <Input
              id="altitudeM"
              type="number"
              min={0}
              max={3000}
              value={form.altitudeM}
              onChange={(e) =>
                updateForm("altitudeM", Number(e.target.value))
              }
            />
          </FormField>
        </div>
      </CardContent>
    </Card>
  );
}

