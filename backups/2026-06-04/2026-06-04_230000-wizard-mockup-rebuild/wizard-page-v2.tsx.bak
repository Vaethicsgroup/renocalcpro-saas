}

function StepHousehold({ form, updateForm }: StepProps) {
  return (
    <Card>
      <CardHeader>
        <CardTitle>Foyer &amp; confort</CardTitle>
        <CardDescription>
          Informations utiles pour estimer l&apos;ECS et les aides mobilisables.
        </CardDescription>
      </CardHeader>
      <CardContent>
        <div className="grid gap-4 sm:grid-cols-2">
          <FormField label="Occupants" htmlFor="occupants" helper="Estimation OK.">
            <Input
              id="occupants"
              type="number"
              min={1}
              max={30}
              value={form.occupants}
              onChange={(e) =>
                updateForm("occupants", Number(e.target.value))
              }
            />
          </FormField>
          <FormField
            label="Température cible hiver (°C)"
            htmlFor="setpointWinterC"
            helper="Défaut 19 °C."
          >
            <Input
              id="setpointWinterC"
              type="number"
              min={14}
              max={26}
              value={form.setpointWinterC ?? 19}
              onChange={(e) =>
                updateForm("setpointWinterC", Number(e.target.value))
              }
            />
          </FormField>
          <FormField
            label="Taille du foyer fiscal"
