            htmlFor="heatingInstallYear"
          >
            <Input
              id="heatingInstallYear"
              type="number"
              min={1900}
              max={2030}
              value={form.heatingInstallYear ?? ""}
              onChange={(e) =>
                updateForm(
                  "heatingInstallYear",
                  e.target.value ? Number(e.target.value) : undefined,
                )
              }
