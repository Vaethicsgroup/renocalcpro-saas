  { value: "COPRO_PARTIES_COMMUNES", label: "Copropriété (parties communes)" },
  { value: "TERTIAIRE_BUREAU",       label: "Tertiaire — bureau" },
  { value: "TERTIAIRE_COMMERCE",     label: "Tertiaire — commerce" },
];

