              onChange={(e) =>
                updateForm(
                  "dhwKind",
                  e.target.value as BuildingFormData["dhwKind"],
                )
              }
            >
              {DHWS.map((d) => (
                <option key={d.value} value={d.value}>
                  {d.label}
                </option>
              ))}
            </Select>
