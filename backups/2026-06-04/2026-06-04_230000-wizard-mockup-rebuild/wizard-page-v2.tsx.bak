              }
            />
          </FormField>
          <FormField
            label="Plancher bas (m²)"
            htmlFor="floorSurfaceM2"
            helper="Sur vide sanitaire / sous-sol / terre-plein."
          >
            <Input
              id="floorSurfaceM2"
              type="number"
              min={0}
              value={form.floorSurfaceM2}
              onChange={(e) =>
                updateForm("floorSurfaceM2", Number(e.target.value))
              }
            />
          </FormField>
          <FormField
            label="Surface vitrée totale (m²)"
            htmlFor="windowSurfaceM2"
          >
            <Input
              id="windowSurfaceM2"
              type="number"
              min={0}
              value={form.windowSurfaceM2}
              onChange={(e) =>
                updateForm("windowSurfaceM2", Number(e.target.value))
              }
            />
          </FormField>
        </div>
        <div className="mt-4">
          <FormField label="Type de vitrage principal" htmlFor="windowGlazing">
            <Select
              id="windowGlazing"
              value={form.windowGlazing}
              onChange={(e) =>
                updateForm(
                  "windowGlazing",
                  e.target.value as BuildingFormData["windowGlazing"],
                )
              }
            >
              {GLAZINGS.map((g) => (
                <option key={g.value} value={g.value}>
                  {g.label}
                </option>
              ))}
            </Select>
          </FormField>
