// app/[locale]/p/projects/new/page.tsx — Wizard création projet particulier v1.0
// « Lot 1 audit fonctionnel » : premier vrai parcours de saisie bâtiment
// branché sur le moteur de calcul existant.
//
// Architecture :
//   - 7 étapes mobile-first (stepper visuel + sticky CTA bar)
//   - State machine en useState (pas de URL params côté client)
//   - Au step 7, appel server action `submitCalcForm` → moteur → ProjectResult
//   - Rendu inline du résultat (DPE, GES, scénarios, aides) sans nouvelle route
//
// Périmètre strict :
//   - aucune migration Prisma (ProjectCalcSnapshot existe déjà)
//   - aucun touch moteur (utilise types + formToBuildingInputs existants)
//   - aucun touch billing logic (gate fire pas ici — wizard ne crée pas de Project)
//   - aucun touch PDF (lien différé)
//   - aucun touch auth (anonymous user → snapshot persiste si DB dispo)
//   - aucun touch routes API
//
// DA Energy Trust : fond cream-50, halo discret, cards blanches bordure cream,
// titres bleu nuit, CTAs vert énergie / orange solaire upgrade.

"use client";

import { useState, useTransition } from "react";
import Link from "next/link";
import {
  ArrowLeft,
  ArrowRight,
  Sparkles,
  Check,
  Loader2,
  AlertTriangle,
  ClipboardList,
  Home,
  Layers,
  Settings,
  Users,
  Target,
  Calculator,
  MapPin,
  Locate,
  type LucideIcon,
} from "lucide-react";
import { useLocale } from "next-intl";
import { OnboardingStepper } from "@/components/onboarding/OnboardingStepper";
import {
  Card,
  CardHeader,
  CardTitle,
  CardDescription,
  CardContent,
} from "@/components/ui/Card";
import { Button } from "@/components/ui/Button";
import { FormField, Input, Select } from "@/components/ui/Input";
import { DPELabel } from "@/components/results/DPELabel";
import { AddressAutocomplete } from "@/components/forms/AddressAutocomplete";
import {
  computeFromForm,
  type ComputeFromFormResult,
} from "@/server/actions/calcForm";
import type { BuildingFormData } from "@/lib/calc/form/schema";
import type { ProjectResult } from "@/lib/calc";
import {
  climateZoneFromPostalCode,
  CLIMATE_ZONE_LABELS_FR,
} from "@/lib/geo/postalCodeToClimateZone";
import {
  reverseGeocode,
  type BanFeature,
} from "@/lib/geo/banGeocoding";

// ─── Schéma initial ────────────────────────────────────────────────────────

const STEPS: ReadonlyArray<{ key: string; label: string; Icon: LucideIcon }> =
  [
    { key: "location",   label: "Localisation", Icon: MapPin },
    { key: "context",    label: "Contexte",     Icon: ClipboardList },
    { key: "geometry",   label: "Géométrie",    Icon: Home },
    { key: "envelope",   label: "Enveloppe",    Icon: Layers },
    { key: "systems",    label: "Systèmes",     Icon: Settings },
    { key: "household",  label: "Foyer",        Icon: Users },
    { key: "scenarios",  label: "Scénarios",    Icon: Target },
    { key: "compute",    label: "Calculer",     Icon: Calculator },
  ];

/** Champs de localisation tenus hors BuildingFormData (le moteur n'en a pas
 *  besoin directement — ils servent à pré-remplir climateZone et à afficher
 *  contexte à l'utilisateur). */
interface LocationState {
  addressLabel: string;
  postalCode: string;
  city: string;
  latitude: number | null;
  longitude: number | null;
}

const INITIAL_FORM: BuildingFormData = {
  projectName: "Mon premier diagnostic",
  buildingType: "MAISON_INDIV",
  constructionPeriod: "1975_1981",
  climateZone: "H1a",
  altitudeM: 100,
  surfaceHabitableM2: 110,
  hauteurSousPlafondM: 2.5,
  niveauCount: 1,
  wallSurfaceM2: 130,
  roofSurfaceM2: 70,
  floorSurfaceM2: 60,
  windowSurfaceM2: 18,
  windowGlazing: "DOUBLE_AIR",
  heatingKind: "CHAUDIERE_GAZ_STD",
  heatingInstallYear: undefined,
  dhwKind: "BALLON_ELEC",
  ventilationKind: "VMC_SF_AUTO",
  occupants: 3,
  setpointWinterC: 19,
  householdSize: 3,
  householdRfrEur: undefined,
  householdIdf: false,
  scenariosEnabled: {
    isolationOnly: true,
    heatingOnly: false,
    global: true,
  },
};

// ─── Options vivantes (labels FR) ──────────────────────────────────────────

