  label: string;
}> = [
  { value: "SIMPLE",        label: "Simple vitrage" },
  { value: "DOUBLE_AIR",    label: "Double vitrage (air)" },
  { value: "DOUBLE_ARGON",  label: "Double vitrage (argon)" },
  { value: "TRIPLE",        label: "Triple vitrage" },
];

