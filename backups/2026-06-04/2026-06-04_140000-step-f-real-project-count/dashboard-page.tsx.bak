// app/[locale]/p/dashboard/page.tsx — Dashboard particulier Premium v2.1
// Server Component : DashboardHero + carte freemium (étape E) + projet en cours
// + KPIs persos + scénario favori + prochaines étapes.

import { setRequestLocale } from "next-intl/server";
import Link from "next/link";
import { DashboardHero } from "@/components/p/DashboardHero";
import { Card, CardHeader, CardTitle, CardDescription, CardContent } from "@/components/ui/Card";
import { KpiCard } from "@/components/ui/KpiCard";
import { Button } from "@/components/ui/Button";
import { DPELabel } from "@/components/results/DPELabel";
import { DashboardFreemiumCard } from "@/components/billing/DashboardFreemiumCard";
import { getCurrentBillingPlan } from "@/server/auth/getCurrentBillingPlan";
import { getCurrentActiveProjectsCount } from "@/server/auth/getCurrentActiveProjectsCount";
import { getRemainingProjects } from "@/lib/billing/usage-policy";

interface DashboardProps {
  params: Promise<{ locale: string }>;
}

export default async function ParticulierDashboard({ params }: DashboardProps) {
  const { locale } = await params;
  setRequestLocale(locale);

  // Étape F — plan billing + comptage RÉEL des projets actifs.
  // Les deux lectures sont fail-soft / fail-closed et ne throw jamais. En
  // parallèle pour économiser une latence DB (Promise.all).
  const [billingPlan, activeProjectsCount] = await Promise.all([
    getCurrentBillingPlan(),
    getCurrentActiveProjectsCount(),
  ]);
  const remainingProjects = getRemainingProjects(billingPlan, {
    activeProjectsCount,
    pdfExportsThisMonth: 0,
    emailVerified: true,
  });

  // MVP : valeurs mock — à brancher sur Prisma + session NextAuth
  const project = {
    id: "demo",
    name: "Maison des Tilleuls",
    location: "87000 Limoges",
    surfaceM2: 120,
    constructionYear: 1978,
    currentDPE: "E" as const,
    targetDPE: "B" as const,
    progress: 60,
    favScenarioName: "Scénario Équilibré",
    favScenarioBudget: 45_800,
    favScenarioAids: 18_650,
    monthlySavings: 142,
    annualSavings: 1_245,
    nextStep: { label: "Valider mon scénario", href: "/p/projects/demo/works", description: "Choisissez parmi 3 propositions chiffrées" },
    upcomingTasks: [
      "Valider mon scénario",
      "Constituer mon dossier d'aides",
      "Choisir mes artisans RGE",
      "Planifier les travaux",
    ],
  };

  return (
    <div className="space-y-8">
      <DashboardHero locale={locale} firstName="Claire" nextStep={project.nextStep} />

      {/* Étape E — Carte freemium (badge plan + compteur projets + CTA upgrade) */}
      <DashboardFreemiumCard
        plan={billingPlan}
        remainingProjects={remainingProjects}
        locale={locale}
      />

      {/* Projet en cours */}
      <section className="grid gap-6 lg:grid-cols-[1.4fr_1fr]">
        <Card>
          <div className="flex items-start gap-4">
            {/* Vignette projet (gradient placeholder) */}
            <div
              aria-hidden
              className="hidden h-24 w-32 shrink-0 rounded-lg bg-gradient-to-br from-amber-100 via-stone-100 to-teal-50 shadow-soft sm:block"
            />
            <div className="min-w-0 flex-1">
              <p className="text-2xs font-semibold uppercase tracking-wider text-teal-700">Mon projet</p>
              <h2
                className="mt-1 font-serif text-2xl font-bold text-stone-900"
                style={{ fontFamily: "Source Serif 4, Georgia, serif" }}
              >
                {project.name}
              </h2>
              <p className="mt-1 text-sm text-stone-600">{project.location}</p>

              <dl className="mt-4 grid grid-cols-3 gap-4 border-t border-stone-100 pt-4 text-xs">
                <div>
                  <dt className="text-stone-500">Surface</dt>
                  <dd className="mt-0.5 text-base font-bold text-stone-900 tabular-nums">{project.surfaceM2} m²</dd>
                </div>
                <div>
                  <dt className="text-stone-500">Année</dt>
                  <dd className="mt-0.5 text-base font-bold text-stone-900 tabular-nums">{project.constructionYear}</dd>
                </div>
                <div>
                  <dt className="text-stone-500">Étiquette actuelle</dt>
                  <dd className="mt-0.5 inline-block">
                    <DPELabel classification={project.currentDPE} size="sm" />
                  </dd>
                </div>
              </dl>
            </div>
          </div>
        </Card>

        {/* Avancement projet — stepper visuel */}
        <Card>
          <CardHeader>
            <CardTitle>Avancement du projet</CardTitle>
          </CardHeader>
          <CardContent>
            <div className="flex items-center gap-2">
              {["Diagnostic terminé", "Scénarios créés", "Choix du scénario", "Dossier d'aides", "Travaux"].map((step, i) => {
                const done = i < 3;
                const active = i === 2;
                return (
                  <div key={step} className="flex flex-col items-center gap-1.5">
                    <span
                      aria-current={active ? "step" : undefined}
                      className={[
                        "flex h-8 w-8 items-center justify-center rounded-full text-xs font-bold transition",
                        done ? "bg-success-600 text-white" : active ? "bg-teal-700 text-white ring-4 ring-teal-100" : "bg-stone-200 text-stone-500",
                      ].join(" ")}
                    >
                      {done ? "✓" : i + 1}
                    </span>
                    <span className={["text-2xs leading-tight text-center", active ? "font-semibold text-teal-800" : "text-stone-500"].join(" ")}>
                      {step.split(" ")[0]}
                    </span>
                  </div>
                );
              })}
            </div>
            <div className="mt-4 h-2 overflow-hidden rounded-full bg-stone-100">
              <div className="h-full bg-gradient-to-r from-teal-600 to-amber-500" style={{ width: `${project.progress}%` }} />
            </div>
            <p className="mt-2 text-xs text-stone-500">{project.progress} % complété</p>
          </CardContent>
        </Card>
      </section>

      {/* KPIs persos */}
      <section className="grid gap-4 sm:grid-cols-3" aria-label="Indicateurs clés">
        <KpiCard
          icon={<span aria-hidden>❄</span>}
          iconBg="bg-info-100"
          iconColor="text-info-700"
          label="Confort hiver"
          value="+ 2,3 °C"
          trend={{ direction: "up", value: "ressenti", period: "après travaux" }}
          helpText="Moins de paroi froide, plus de bien-être"
        />
        <KpiCard
          icon={<span aria-hidden>☀</span>}
          iconBg="bg-amber-100"
          iconColor="text-amber-700"
          label="Confort été"
          value="− 3,6 °C"
          trend={{ direction: "down", value: "surchauffe", period: "évitée" }}
          helpText="Combles isolées + ventilation nocturne"
        />
        <KpiCard
          icon={<span aria-hidden>💶</span>}
          iconBg="bg-success-100"
          iconColor="text-success-700"
          label="Économies / an"
          value={`${project.annualSavings.toLocaleString("fr-FR")} €`}
          trend={{ direction: "up", value: "−62 %", period: "facture énergie" }}
          helpText={`Soit environ ${project.monthlySavings} € / mois`}
        />
      </section>

      {/* Scénario favori */}
      <section>
        <Card variant="featured">
          <div className="flex flex-col gap-6 lg:flex-row lg:items-start">
            <div className="flex-1">
              <div className="flex items-center gap-2">
                <span className="rounded-full bg-amber-200 px-2 py-0.5 text-2xs font-bold text-amber-900">★ Favori</span>
                <p className="text-2xs font-semibold uppercase tracking-wider text-teal-700">Mon scénario favori</p>
              </div>
              <h2
                className="mt-2 font-serif text-2xl font-bold text-stone-900"
                style={{ fontFamily: "Source Serif 4, Georgia, serif" }}
              >
                {project.favScenarioName}
              </h2>

              <dl className="mt-5 grid grid-cols-2 gap-4 sm:grid-cols-4">
                <div>
                  <dt className="text-2xs font-semibold uppercase tracking-wider text-stone-500">Budget</dt>
                  <dd className="mt-1 font-serif text-lg font-bold text-stone-900 tabular-nums">{project.favScenarioBudget.toLocaleString("fr-FR")} € TTC</dd>
                </div>
                <div>
                  <dt className="text-2xs font-semibold uppercase tracking-wider text-stone-500">Économies</dt>
                  <dd className="mt-1 font-serif text-lg font-bold text-success-700 tabular-nums">{project.annualSavings.toLocaleString("fr-FR")} € / an</dd>
                </div>
                <div>
                  <dt className="text-2xs font-semibold uppercase tracking-wider text-stone-500">Étiquette après</dt>
                  <dd className="mt-1"><DPELabel classification={project.targetDPE} size="md" /></dd>
                </div>
                <div>
                  <dt className="text-2xs font-semibold uppercase tracking-wider text-stone-500">Aides estimées</dt>
                  <dd className="mt-1 font-serif text-lg font-bold text-teal-700 tabular-nums">{project.favScenarioAids.toLocaleString("fr-FR")} €</dd>
                </div>
              </dl>

              <div className="mt-5 flex flex-wrap gap-2">
                <Link
                  href={`/${locale}/p/projects/${project.id}/works`}
                  className="inline-flex h-10 items-center justify-center rounded-md bg-teal-700 px-4 text-sm font-semibold text-white hover:bg-teal-800"
                >
                  Voir le détail du scénario
                </Link>
                <Link
                  href={`/${locale}/p/projects/${project.id}/aids`}
                  className="inline-flex h-10 items-center justify-center rounded-md border border-stone-300 bg-white px-4 text-sm font-semibold text-stone-700 hover:bg-stone-50"
                >
                  Voir les aides
                </Link>
              </div>
            </div>
          </div>
        </Card>
      </section>

      {/* Prochaines étapes */}
      <section className="grid gap-6 lg:grid-cols-[1.2fr_1fr]">
        <Card>
          <CardHeader>
            <CardTitle>Mes prochaines étapes</CardTitle>
            <CardDescription>4 étapes pour finaliser votre projet et démarrer les travaux</CardDescription>
          </CardHeader>
          <CardContent>
            <ol className="space-y-3">
              {project.upcomingTasks.map((task, i) => (
                <li key={task} className="flex items-start gap-3">
                  <span aria-hidden className={[
                    "mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full text-xs font-bold",
                    i === 0 ? "bg-teal-700 text-white" : "bg-stone-200 text-stone-500",
                  ].join(" ")}>
                    {i + 1}
                  </span>
                  <span className={["text-sm", i === 0 ? "font-semibold text-stone-900" : "text-stone-600"].join(" ")}>{task}</span>
                </li>
              ))}
            </ol>
          </CardContent>
        </Card>

        {/* Carte accompagnement */}
        <Card variant="default" className="bg-sage-50 border-sage-200">
          <div className="text-center">
            <div aria-hidden className="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-sage-200 text-2xl">
              💬
            </div>
            <h3 className="mt-3 font-serif text-lg font-bold text-stone-900" style={{ fontFamily: "Source Serif 4, Georgia, serif" }}>
              Un accompagnement personnalisé
            </h3>
            <p className="mt-2 text-sm text-stone-600">
              Vos questions méritent une vraie réponse. Notre équipe vous accompagne à chaque étape de votre rénovation.
            </p>
            <div className="mt-4 flex flex-col gap-2">
              <Button variant="primary" size="md" fullWidth>
                <Link href={`/${locale}/contact`} className="contents">Poser une question</Link>
              </Button>
              <Button variant="secondary" size="md" fullWidth>
                <Link href={`/${locale}/help`} className="contents">Centre d'aide</Link>
              </Button>
            </div>
          </div>
        </Card>
      </section>
    </div>
  );
}
