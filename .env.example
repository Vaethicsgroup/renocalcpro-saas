# ─── RÉNO·CALC PRO SAAS — Variables d'environnement ───────────────────────────
# Ce fichier sert de référence. Copie-le en `.env.production` et remplis avec
# les valeurs réelles. NE JAMAIS commiter `.env.production` dans git.

# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://renocalcpro.fr
NEXT_PUBLIC_APP_NAME="Réno·Calc Pro"
NEXT_PUBLIC_DEFAULT_LOCALE=fr
APP_LOG_LEVEL=info

# ─── Base de données PostgreSQL ───────────────────────────────────────────────
# Format : postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public&sslmode=require
DATABASE_URL=postgresql://renocal:CHANGE_ME@db:5432/renocal?schema=public

# Pour les pools de connexions en serverless (optionnel)
DATABASE_DIRECT_URL=

# ─── Auth (NextAuth v5) ───────────────────────────────────────────────────────
# Clé symétrique pour signer les sessions JWT — générer avec : openssl rand -base64 64
AUTH_SECRET=GENERATE_OPENSSL_RAND_BASE64_64
AUTH_URL=https://renocalcpro.fr
AUTH_TRUST_HOST=true

# Email magic-link (Resend ou SMTP)
AUTH_EMAIL_FROM=auth@renocalcpro.fr
RESEND_API_KEY=
# ou SMTP traditionnel
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# OAuth (optionnel)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# ─── Stockage objet (OVH Public Cloud Storage S3-compatible) ──────────────────
STORAGE_DRIVER=s3                 # local-fs en dev | s3 en prod
S3_ENDPOINT=https://s3.gra.io.cloud.ovh.net
S3_REGION=gra
S3_BUCKET=renocal-prod-photos
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
S3_PRESIGN_TTL_SECONDS=900        # URLs expirantes 15 min

# Driver local-fs (dev uniquement)
LOCAL_STORAGE_PATH=./storage

# ─── Redis (queue jobs + rate-limit + cache LLM) ──────────────────────────────
REDIS_URL=redis://default:CHANGE_ME@redis:6379

# ─── Anthropic Claude API ─────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_ORCHESTRATOR=claude-opus-4-7
ANTHROPIC_MODEL_AGENTS=claude-sonnet-4-6
ANTHROPIC_MODEL_CLASSIFY=claude-haiku-4-5-20251001
ANTHROPIC_MAX_TOKENS=4096

# ─── Antivirus (ClamAV sidecar) ───────────────────────────────────────────────
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=15000

# ─── Géocodage (BAN gratuit ; OSM Nominatim fallback) ─────────────────────────
NEXT_PUBLIC_GEOCODE_PROVIDER=ban  # ban | nominatim

# ─── Audit log HMAC ───────────────────────────────────────────────────────────
# Clé HMAC pour signer chaque ligne d'audit log (intégrité append-only)
AUDIT_HMAC_KEY=GENERATE_OPENSSL_RAND_HEX_32

# ─── Sentry (monitoring optionnel) ────────────────────────────────────────────
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=

# ─── Feature flags ────────────────────────────────────────────────────────────
FEATURE_AGENTS_ENABLED=false      # toggle orchestrateur Claude
FEATURE_PHOTOS_AI_ANALYSIS=false  # toggle analyse vision photos
FEATURE_BILLING_ENABLED=false
